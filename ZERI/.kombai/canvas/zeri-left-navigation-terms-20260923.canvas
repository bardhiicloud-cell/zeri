    },
    "var_dc61fe978d14": {
      "type": "variant",
      "label": "Compact — Flat Primary Sidebar + Consent",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,600&family=Merriweather:ital,wght@0,400;0,700;0,900;1,400&display=swap');\n  :root { --brand-navy: #071322; --brand-blue: #1e40af; --action-blue: #2563eb; --page: #f0f7ff; --soft-border: #d1e4f2; }\n</style>\n<script src=\"https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js\">\n</script>\n<div class=\"min-h-screen w-full bg-[var(--page)] font-sans text-slate-900 antialiased\" data-kid=\"1\" data-name=\"page layout container\" style=\"font-family:'Plus Jakarta Sans',sans-serif;\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\" data-name=\"main application layout\">\n        <aside class=\"sticky top-0 flex h-screen w-[272px] shrink-0 flex-col overflow-hidden bg-[var(--brand-navy)] text-white shadow-[14px_0_42px_-28px_rgba(7,19,34,0.6)]\" data-kid=\"1-1-1\" data-name=\"navigation sidebar\">\n            <div class=\"border-b border-white/10 px-4 py-4\" data-kid=\"1-1-1-1\" data-name=\"branding header section\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-1-1\" data-name=\"branding logo container\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-blue-600 text-lg font-black shadow-lg shadow-blue-900/40\" data-kid=\"1-1-1-1-1-1\" data-name=\"brand initial icon\">\n                        Z\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-1-1-1-1-2\" data-name=\"brand title text container\">\n                        <p class=\"truncate text-[13px] font-extrabold tracking-tight\" data-kid=\"1-1-1-1-1-2-1\" data-name=\"platform name text\">\n                            Zëri Qytetarëve\n                        </p>\n                        <p class=\"truncate text-[10px] font-medium text-blue-200/80\" data-kid=\"1-1-1-1-1-2-2\" data-name=\"organization subtitle text\">\n                            Republika e Kosovës\n                        </p>\n                    </div>\n                    <span class=\"ml-auto h-2 w-2 shrink-0 rounded-full bg-emerald-400 shadow-[0_0_0_4px_rgba(52,211,153,0.12)]\" data-kid=\"1-1-1-1-1-3\" data-name=\"system status indicator\" title=\"Sistemi aktiv\">\n                    </span>\n                </div>\n            </div>\n            <div class=\"px-3 py-3\" data-kid=\"1-1-1-2\" data-name=\"region selector section\">\n                <div class=\"rounded-xl border border-blue-400/30 bg-blue-500/15 px-3 py-2\" data-kid=\"1-1-1-2-1\" data-name=\"region selector card\">\n                    <div class=\"flex items-center justify-between gap-2\" data-kid=\"1-1-1-2-1-1\" data-name=\"region header container\">\n                        <span class=\"text-[9px] font-extrabold uppercase tracking-[0.16em] text-blue-200\" data-kid=\"1-1-1-2-1-1-1\" data-name=\"region label\">\n                            Zona juaj\n                        </span>\n                        <i class=\"h-3.5 w-3.5 text-blue-300\" data-kid=\"1-1-1-2-1-1-2\" data-lucide=\"map-pin\" data-name=\"location map pin icon\">\n                        </i>\n                    </div>\n                    <p class=\"mt-1 text-xs font-bold text-white\" data-kid=\"1-1-1-2-1-2\" data-name=\"selected region name\">\n                        Kosova — të gjitha komunat\n                    </p>\n                </div>\n            </div>\n            <div class=\"px-3 pb-3\" data-kid=\"1-1-1-3\" data-name=\"report issue button container\">\n                <a class=\"flex h-10 items-center justify-center gap-2 rounded-xl bg-blue-600 px-3 text-xs font-extrabold text-white shadow-lg shadow-blue-950/40 ring-1 ring-blue-400/30\" data-kid=\"1-1-1-3-1\" data-name=\"report issue call-to-action button\" href=\"#\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-1-3-1-1\" data-lucide=\"pen-line\" data-name=\"pencil icon\">\n                    </i>\n                    Raporto një problem\n                    <i class=\"ml-auto h-3.5 w-3.5 text-blue-100\" data-kid=\"1-1-1-3-1-2\" data-lucide=\"arrow-up-right\" data-name=\"external link icon\">\n                    </i>\n                </a>\n            </div>\n            <nav aria-label=\"Navigimi kryesor\" class=\"min-h-0 flex-1 overflow-hidden px-3\" data-kid=\"1-1-1-4\" data-name=\"main navigation menu\">\n                <p class=\"mb-2 px-2 text-[9px] font-extrabold uppercase tracking-[0.18em] text-slate-400\" data-kid=\"1-1-1-4-1\" data-name=\"navigation menu section label\">\n                    Navigimi kryesor\n                </p>\n                <div class=\"space-y-1\" data-kid=\"1-1-1-4-2\" data-name=\"navigation menu links list\">\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg bg-white/12 px-3 text-[11px] font-extrabold text-white ring-1 ring-inset ring-white/10\" data-kid=\"1-1-1-4-2-1\" data-name=\"active dashboard menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-blue-300\" data-kid=\"1-1-1-4-2-1-1\" data-lucide=\"house\" data-name=\"dashboard icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-1-2\" data-name=\"dashboard menu text\">\n                            Ballina\n                        </span>\n                        <span class=\"ml-auto h-1.5 w-1.5 rounded-full bg-blue-300\" data-kid=\"1-1-1-4-2-1-3\" data-name=\"active indicator dot\">\n                        </span>\n                    </a>\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg px-3 text-[11px] font-semibold text-slate-300 hover:bg-white/8\" data-kid=\"1-1-1-4-2-2\" data-name=\"report menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-slate-400 group-hover:text-blue-300\" data-kid=\"1-1-1-4-2-2-1\" data-lucide=\"pen-square\" data-name=\"report icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-2-2\" data-name=\"report menu text\">\n                            Raporto\n                        </span>\n                    </a>\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg px-3 text-[11px] font-semibold text-slate-300 hover:bg-white/8\" data-kid=\"1-1-1-4-2-3\" data-name=\"map menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-slate-400 group-hover:text-blue-300\" data-kid=\"1-1-1-4-2-3-1\" data-lucide=\"map\" data-name=\"map icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-3-2\" data-name=\"map menu text\">\n                            Harta\n                        </span>\n                    </a>\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg px-3 text-[11px] font-semibold text-slate-300 hover:bg-white/8\" data-kid=\"1-1-1-4-2-4\" data-name=\"reports list menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-slate-400 group-hover:text-blue-300\" data-kid=\"1-1-1-4-2-4-1\" data-lucide=\"newspaper\" data-name=\"newspaper icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-4-2\" data-name=\"reports list menu text\">\n                            Raportimet\n                        </span>\n                    </a>\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg px-3 text-[11px] font-semibold text-slate-300 hover:bg-white/8\" data-kid=\"1-1-1-4-2-5\" data-name=\"health registry menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-slate-400 group-hover:text-emerald-300\" data-kid=\"1-1-1-4-2-5-1\" data-lucide=\"heart-pulse\" data-name=\"heart pulse icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-5-2\" data-name=\"health registry menu text\">\n                            Regjistri Shëndetësor\n                        </span>\n                    </a>\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg px-3 text-[11px] font-semibold text-slate-300 hover:bg-white/8\" data-kid=\"1-1-1-4-2-6\" data-name=\"statistics menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-slate-400 group-hover:text-blue-300\" data-kid=\"1-1-1-4-2-6-1\" data-lucide=\"chart-column-big\" data-name=\"chart icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-6-2\" data-name=\"statistics menu text\">\n                            Statistikat\n                        </span>\n                    </a>\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg px-3 text-[11px] font-semibold text-slate-300 hover:bg-white/8\" data-kid=\"1-1-1-4-2-7\" data-name=\"public debate menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-slate-400 group-hover:text-blue-300\" data-kid=\"1-1-1-4-2-7-1\" data-lucide=\"messages-square\" data-name=\"messages icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-7-2\" data-name=\"public debate menu text\">\n                            Debati Publik\n                        </span>\n                    </a>\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg px-3 text-[11px] font-semibold text-slate-300 hover:bg-white/8\" data-kid=\"1-1-1-4-2-8\" data-name=\"donations menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-slate-400 group-hover:text-rose-300\" data-kid=\"1-1-1-4-2-8-1\" data-lucide=\"heart-handshake\" data-name=\"heart handshake icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-8-2\" data-name=\"donations menu text\">\n                            Ndihma & Donacione\n                        </span>\n                    </a>\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg px-3 text-[11px] font-semibold text-slate-300 hover:bg-white/8\" data-kid=\"1-1-1-4-2-9\" data-name=\"numbers menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-slate-400 group-hover:text-blue-300\" data-kid=\"1-1-1-4-2-9-1\" data-lucide=\"phone-call\" data-name=\"phone icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-9-2\" data-name=\"numbers menu text\">\n                            Numrat & Institucionet\n                        </span>\n                    </a>\n                    <a class=\"group flex h-9 items-center gap-3 rounded-lg px-3 text-[11px] font-semibold text-slate-300 hover:bg-white/8\" data-kid=\"1-1-1-4-2-10\" data-name=\"help center menu link\" href=\"#\">\n                        <i class=\"h-4 w-4 text-slate-400 group-hover:text-amber-300\" data-kid=\"1-1-1-4-2-10-1\" data-lucide=\"life-buoy\" data-name=\"life buoy icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-2-10-2\" data-name=\"help center menu text\">\n                            Qendra e Ndihmës\n                        </span>\n                    </a>\n                </div>\n                <div class=\"mt-4 border-t border-white/10 pt-3\" data-kid=\"1-1-1-4-3\" data-name=\"footer navigation extra section\">\n                    <div class=\"flex items-center justify-between px-2 text-[9px] font-extrabold uppercase tracking-[0.16em] text-slate-500\" data-kid=\"1-1-1-4-3-1\" data-name=\"more menu header\">\n                        <span data-kid=\"1-1-1-4-3-1-1\" data-name=\"more label text\">\n                            Më shumë\n                        </span>\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-1-4-3-1-2\" data-lucide=\"chevron-down\" data-name=\"chevron down icon\">\n                        </i>\n                    </div>\n                    <div class=\"mt-1 flex items-center gap-2 px-2 py-2 text-[10px] font-semibold text-slate-400\" data-kid=\"1-1-1-4-3-2\" data-name=\"footer nav description\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-1-4-3-2-1\" data-lucide=\"ellipsis\" data-name=\"ellipsis icon\">\n                        </i>\n                        <span data-kid=\"1-1-1-4-3-2-2\" data-name=\"footer links text\">\n                            Komunat · Lajmet · Kontakt\n                        </span>\n                    </div>\n                </div>\n            </nav>\n            <div class=\"mt-auto space-y-2 border-t border-white/10 px-3 py-3\" data-kid=\"1-1-1-5\" data-name=\"sidebar footer section\">\n                <a class=\"flex h-9 items-center gap-2 rounded-lg bg-blue-500/15 px-3 text-[10px] font-extrabold text-blue-200 ring-1 ring-inset ring-blue-400/20\" data-kid=\"1-1-1-5-1\" data-name=\"terms service link button\" href=\"#\">\n                    <i class=\"h-4 w-4 text-blue-300\" data-kid=\"1-1-1-5-1-1\" data-lucide=\"scale\" data-name=\"scale icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-5-1-2\" data-name=\"terms service button text\">\n                        Terms & Service\n                    </span>\n                    <i class=\"ml-auto h-3.5 w-3.5\" data-kid=\"1-1-1-5-1-3\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\">\n                    </i>\n                </a>\n                <div class=\"flex items-center gap-2 rounded-lg bg-white/6 px-2.5 py-2\" data-kid=\"1-1-1-5-2\" data-name=\"user session container\">\n                    <div class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-slate-600 text-xs font-black\" data-kid=\"1-1-1-5-2-1\" data-name=\"user avatar placeholder\">\n                        M\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-1-1-5-2-2\" data-name=\"user info text container\">\n                        <p class=\"truncate text-[10px] font-bold text-white\" data-kid=\"1-1-1-5-2-2-1\" data-name=\"username text\">\n                            Mysafir #MUDEW\n                        </p>\n                        <p class=\"text-[9px] text-slate-400\" data-kid=\"1-1-1-5-2-2-2\" data-name=\"session type text\">\n                            Sesioni lokal\n                        </p>\n                    </div>\n                    <i class=\"h-3.5 w-3.5 text-slate-400\" data-kid=\"1-1-1-5-2-3\" data-lucide=\"bell\" data-name=\"notification bell icon\">\n                    </i>\n                </div>\n                <div class=\"flex items-center justify-between px-1 text-[9px] text-slate-500\" data-kid=\"1-1-1-5-3\" data-name=\"footer branding section\">\n                    <span data-kid=\"1-1-1-5-3-1\" data-name=\"copyright text\">\n                        © 2026 Zëri Qytetarëve\n                    </span>\n                    <span class=\"flex items-center gap-1\" data-kid=\"1-1-1-5-3-2\" data-name=\"security status badge\">\n                        <i class=\"h-3 w-3 text-emerald-400\" data-kid=\"1-1-1-5-3-2-1\" data-lucide=\"shield-check\" data-name=\"shield icon\">\n                        </i>\n                        Sigurt\n                    </span>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 bg-[#f3f7fb]\" data-kid=\"1-1-2\" data-name=\"main content area\">\n            <div class=\"mx-auto max-w-[1040px] px-7 pb-14 pt-7\" data-kid=\"1-1-2-1\" data-name=\"page content wrapper\">\n                <div class=\"mb-5 flex items-center justify-between gap-4\" data-kid=\"1-1-2-1-1\" data-name=\"breadcrumb navigation bar\">\n                    <div class=\"flex items-center gap-2 text-[11px] font-bold text-slate-500\" data-kid=\"1-1-2-1-1-1\" data-name=\"breadcrumb links container\">\n                        <span data-kid=\"1-1-2-1-1-1-1\" data-name=\"breadcrumb parent link\">\n                            Dokument ligjor\n                        </span>\n                        <i class=\"h-3.5 w-3.5 text-slate-300\" data-kid=\"1-1-2-1-1-1-2\" data-lucide=\"chevron-right\" data-name=\"breadcrumb separator icon\">\n                        </i>\n                        <span class=\"text-slate-900\" data-kid=\"1-1-2-1-1-1-3\" data-name=\"current page breadcrumb label\">\n                            Kushtet e Përdorimit\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2 text-[10px] font-bold text-slate-500\" data-kid=\"1-1-2-1-1-2\" data-name=\"version info container\">\n                        <span class=\"rounded-full border border-slate-200 bg-white px-3 py-1.5\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"version badge\">\n                            Versioni 1.4\n                        </span>\n                        <span class=\"rounded-full border border-slate-200 bg-white px-3 py-1.5\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"last updated date text\">\n                            Përditësuar 19 shtator 2026\n                        </span>\n                    </div>\n                </div>\n                <header class=\"relative overflow-hidden rounded-[24px] bg-[var(--brand-navy)] px-8 py-8 text-white shadow-[0_24px_55px_-32px_rgba(7,19,34,0.75)]\" data-kid=\"1-1-2-1-2\" data-name=\"header section\">\n                    <div class=\"absolute -right-16 -top-24 h-72 w-72 rounded-full bg-blue-600/20 blur-3xl\" data-kid=\"1-1-2-1-2-1\" data-name=\"decorative blur circle 1\">\n                    </div>\n                    <div class=\"absolute -bottom-28 left-1/3 h-64 w-64 rounded-full bg-cyan-400/10 blur-3xl\" data-kid=\"1-1-2-1-2-2\" data-name=\"decorative blur circle 2\">\n                    </div>\n                    <div class=\"relative flex items-end justify-between gap-6\" data-kid=\"1-1-2-1-2-3\" data-name=\"header content layout\">\n                        <div class=\"max-w-[680px]\" data-kid=\"1-1-2-1-2-3-1\" data-name=\"headline text container\">\n                            <div class=\"mb-4 flex items-center gap-3\" data-kid=\"1-1-2-1-2-3-1-1\" data-name=\"headline header container\">\n                                <span class=\"flex h-10 w-10 items-center justify-center rounded-xl bg-blue-600 shadow-lg shadow-blue-950/40\" data-kid=\"1-1-2-1-2-3-1-1-1\" data-name=\"gavel icon container\">\n                                    <i class=\"h-5 w-5\" data-kid=\"1-1-2-1-2-3-1-1-1-1\" data-lucide=\"gavel\" data-name=\"gavel icon\">\n                                    </i>\n                                </span>\n                                <span class=\"text-[10px] font-extrabold uppercase tracking-[0.2em] text-blue-200\" data-kid=\"1-1-2-1-2-3-1-1-2\" data-name=\"header category label\">\n                                    Dokument ligjor\n                                </span>\n                            </div>\n                            <h1 class=\"font-serif text-[42px] font-black leading-[1.08] tracking-[-0.04em]\" data-kid=\"1-1-2-1-2-3-1-2\" data-name=\"page main headline\">\n                                Kushtet e Përdorimit\n                            </h1>\n                            <p class=\"mt-3 max-w-2xl text-sm leading-6 text-slate-300\" data-kid=\"1-1-2-1-2-3-1-3\" data-name=\"page introduction text\">\n                                Rregullat që përcaktojnë përdorimin e sigurt, të drejtë dhe transparent të platformës Zëri i Qytetarëve.\n                            </p>\n                        </div>\n                        <div class=\"hidden shrink-0 rounded-2xl border border-white/15 bg-white/8 px-4 py-3 text-right lg:block\" data-kid=\"1-1-2-1-2-3-2\" data-name=\"read time badge container\">\n                            <p class=\"text-[9px] font-extrabold uppercase tracking-[0.16em] text-blue-200\" data-kid=\"1-1-2-1-2-3-2-1\" data-name=\"call to action text\">\n                                Lexo dhe konfirmo\n                            </p>\n                            <p class=\"mt-1 text-xs font-bold text-white\" data-kid=\"1-1-2-1-2-3-2-2\" data-name=\"duration estimate text\">\n                                10 kapituj · rreth 5 min\n                            </p>\n                        </div>\n                    </div>\n                </header>\n                <div class=\"mt-4 grid grid-cols-3 gap-3\" data-kid=\"1-1-2-1-3\" data-name=\"info cards grid\">\n                    <div class=\"flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm\" data-kid=\"1-1-2-1-3-1\" data-name=\"public info card\">\n                        <i class=\"h-5 w-5 text-blue-600\" data-kid=\"1-1-2-1-3-1-1\" data-lucide=\"file-check-2\" data-name=\"file check icon\">\n                        </i>\n                        <div data-kid=\"1-1-2-1-3-1-2\" data-name=\"card text container\">\n                            <p class=\"text-[11px] font-extrabold text-slate-900\" data-kid=\"1-1-2-1-3-1-2-1\" data-name=\"card title\">\n                                Të qarta dhe publike\n                            </p>\n                            <p class=\"mt-0.5 text-[10px] text-slate-500\" data-kid=\"1-1-2-1-3-1-2-2\" data-name=\"card description\">\n                                Version i dokumentuar\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm\" data-kid=\"1-1-2-1-3-2\" data-name=\"secure usage card\">\n                        <i class=\"h-5 w-5 text-emerald-600\" data-kid=\"1-1-2-1-3-2-1\" data-lucide=\"shield-check\" data-name=\"shield icon\">\n                        </i>\n                        <div data-kid=\"1-1-2-1-3-2-2\" data-name=\"card text container\">\n                            <p class=\"text-[11px] font-extrabold text-slate-900\" data-kid=\"1-1-2-1-3-2-2-1\" data-name=\"card title\">\n                                Përdorim i sigurt\n                            </p>\n                            <p class=\"mt-0.5 text-[10px] text-slate-500\" data-kid=\"1-1-2-1-3-2-2-2\" data-name=\"card description\">\n                                Privatësi dhe moderim\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex items-center gap-3 rounded-2xl border border-slate-200 bg-white px-4 py-3 shadow-sm\" data-kid=\"1-1-2-1-3-3\" data-name=\"civic responsibility card\">\n                        <i class=\"h-5 w-5 text-amber-600\" data-kid=\"1-1-2-1-3-3-1\" data-lucide=\"user-check\" data-name=\"user check icon\">\n                        </i>\n                        <div data-kid=\"1-1-2-1-3-3-2\" data-name=\"card text container\">\n                            <p class=\"text-[11px] font-extrabold text-slate-900\" data-kid=\"1-1-2-1-3-3-2-1\" data-name=\"card title\">\n                                Përgjegjësi qytetare\n                            </p>\n                            <p class=\"mt-0.5 text-[10px] text-slate-500\" data-kid=\"1-1-2-1-3-3-2-2\" data-name=\"card description\">\n                                Respekt në çdo veprim\n                            </p>\n                        </div>\n                    </div>\n                </div>\n                <section class=\"mt-4 rounded-2xl border border-blue-200 bg-white p-5 shadow-[0_14px_30px_-24px_rgba(37,99,235,0.65)]\" data-kid=\"1-1-2-1-4\" data-name=\"terms acceptance section\">\n                    <div class=\"flex flex-col gap-4 xl:flex-row xl:items-center xl:justify-between\" data-kid=\"1-1-2-1-4-1\" data-name=\"acceptance layout container\">\n                        <div class=\"flex items-start gap-3\" data-kid=\"1-1-2-1-4-1-1\" data-name=\"acceptance prompt container\">\n                            <div class=\"mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-blue-50 text-blue-600\" data-kid=\"1-1-2-1-4-1-1-1\" data-name=\"clipboard check icon container\">\n                                <i class=\"h-4.5 w-4.5\" data-kid=\"1-1-2-1-4-1-1-1-1\" data-lucide=\"clipboard-check\" data-name=\"clipboard check icon\">\n                                </i>\n                            </div>\n                            <div data-kid=\"1-1-2-1-4-1-1-2\" data-name=\"acceptance instruction text block\">\n                                <p class=\"text-sm font-extrabold text-slate-900\" data-kid=\"1-1-2-1-4-1-1-2-1\" data-name=\"instruction title\">\n                                    Pranoni rregullat para se të vazhdoni\n                                </p>\n                                <p class=\"mt-1 max-w-[620px] text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-4-1-1-2-2\" data-name=\"instruction description\">\n                                    Duke zgjedhur këtë kuti, konfirmoni se i keni lexuar dhe pranuar të gjitha kushtet më poshtë për raportime, komente dhe shërbime të platformës.\n                                </p>\n                                <label class=\"mt-3 flex items-center gap-2 text-[11px] font-bold text-slate-700\" data-kid=\"1-1-2-1-4-1-1-2-3\" data-name=\"terms agreement label\">\n                                    <span class=\"flex h-4 w-4 items-center justify-center rounded border-2 border-slate-300 bg-white\" data-kid=\"1-1-2-1-4-1-1-2-3-1\" data-name=\"checkbox input visual\">\n                                    </span>\n                                    I kam lexuar dhe pranoj Kushtet e Përdorimit\n                                </label>\n                            </div>\n                        </div>\n                        <button class=\"inline-flex h-10 shrink-0 items-center justify-center gap-2 rounded-xl bg-blue-600 px-4 text-xs font-extrabold text-white opacity-45 shadow-sm\" data-kid=\"1-1-2-1-4-1-2\" data-name=\"proceed button\" disabled=\"\" type=\"button\">\n                            <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-2-1-4-1-2-1\" data-lucide=\"lock-keyhole\" data-name=\"lock icon\">\n                            </i>\n                            Pranoj dhe vazhdoj\n                        </button>\n                    </div>\n                    <div class=\"mt-4 border-t border-blue-100 pt-3 text-[10px] font-semibold text-slate-400\" data-kid=\"1-1-2-1-4-2\" data-name=\"helper message text\">\n                        Zgjidh kutinë për ta aktivizuar butonin e pranimit.\n                    </div>\n                </section>\n                <div class=\"mt-3 flex items-center gap-3 rounded-xl border border-emerald-200 bg-emerald-50/70 px-4 py-3\" data-kid=\"1-1-2-1-5\" data-name=\"status active banner\">\n                    <div class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-emerald-100 text-emerald-700\" data-kid=\"1-1-2-1-5-1\" data-name=\"check icon container\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-1-5-1-1\" data-lucide=\"check\" data-name=\"check icon\">\n                        </i>\n                    </div>\n                    <div class=\"flex min-w-0 flex-1 items-center gap-2\" data-kid=\"1-1-2-1-5-2\" data-name=\"status message text container\">\n                        <span class=\"text-[10px] font-extrabold uppercase tracking-[0.14em] text-emerald-700\" data-kid=\"1-1-2-1-5-2-1\" data-name=\"status label\">\n                            Micro-state\n                        </span>\n                        <span class=\"text-[11px] font-semibold text-emerald-900\" data-kid=\"1-1-2-1-5-2-2\" data-name=\"status detail description\">\n                            Pas zgjedhjes së kutisë, pranimi bëhet aktiv.\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2 rounded-lg border border-emerald-200 bg-white px-2.5 py-1.5\" data-kid=\"1-1-2-1-5-3\" data-name=\"acceptance status badge\">\n                        <span class=\"flex h-4 w-4 items-center justify-center rounded border border-emerald-600 bg-emerald-600 text-white\" data-kid=\"1-1-2-1-5-3-1\" data-name=\"check icon container\">\n                            <i class=\"h-3 w-3\" data-kid=\"1-1-2-1-5-3-1-1\" data-lucide=\"check\" data-name=\"check icon\">\n                            </i>\n                        </span>\n                        <span class=\"text-[10px] font-bold text-slate-700\" data-kid=\"1-1-2-1-5-3-2\" data-name=\"status text\">\n                            Pranuar\n                        </span>\n                    </div>\n                    <button class=\"inline-flex h-8 items-center gap-1.5 rounded-lg bg-emerald-600 px-3 text-[10px] font-extrabold text-white shadow-sm\" data-kid=\"1-1-2-1-5-4\" data-name=\"continue action button\" type=\"button\">\n                        <i class=\"h-3 w-3\" data-kid=\"1-1-2-1-5-4-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\">\n                        </i>\n                        Vazhdoj\n                    </button>\n                </div>\n                <main class=\"mt-4 rounded-[22px] border border-slate-200 bg-white p-6 shadow-[0_18px_40px_-30px_rgba(15,23,42,0.38)]\" data-kid=\"1-1-2-1-6\" data-name=\"terms and conditions content section\">\n                    <div class=\"mb-5 flex items-center gap-3 rounded-xl border border-blue-100 bg-blue-50 px-4 py-3 text-[11px] leading-5 text-blue-900\" data-kid=\"1-1-2-1-6-1\" data-name=\"info banner\">\n                        <i class=\"h-4 w-4 shrink-0 text-blue-600\" data-kid=\"1-1-2-1-6-1-1\" data-lucide=\"info\" data-name=\"info icon\">\n                        </i>\n                        <p data-kid=\"1-1-2-1-6-1-2\" data-name=\"info text\">\n                            Ju lutemi lexoni këto kushte para se të raportoni, komentoni ose përdorni shërbimet e platformës.\n                        </p>\n                    </div>\n                    <div class=\"grid grid-cols-1 gap-x-8 gap-y-0 lg:grid-cols-2\" data-kid=\"1-1-2-1-6-2\" data-name=\"terms sections grid\">\n                        <section class=\"border-b border-slate-100 py-4 lg:pr-4\" data-kid=\"1-1-2-1-6-2-1\" data-name=\"term clause 1\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-1-1\" data-name=\"term title\">\n                                1. Pranimi i kushteve\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-1-2\" data-name=\"term content\">\n                                Duke përdorur Zëri i Qytetarëve, ju pranoni këto Kushte të Përdorimit. Nëse nuk pajtoheni me to, mos përdorni shërbimet e platformës. Kushtet vlejnë për faqen, aplikacionet, hartën, regjistrin e raportimeve, forumin dhe shërbimet e lidhura.\n                            </p>\n                        </section>\n                        <section class=\"border-b border-slate-100 py-4 lg:pl-4\" data-kid=\"1-1-2-1-6-2-2\" data-name=\"term clause 2\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-2-1\" data-name=\"term title\">\n                                2. Qëllimi i platformës\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-2-2\" data-name=\"term content\">\n                                Platforma shërben për raportimin qytetar të problemeve publike, përcjelljen e statusit të tyre, pjesëmarrjen në diskutime dhe qasjen në informacione për komunat dhe institucionet. Platforma nuk zëvendëson kanalet zyrtare të emergjencës ose procedurat administrative.\n                            </p>\n                        </section>\n                        <section class=\"border-b border-slate-100 py-4 lg:pr-4\" data-kid=\"1-1-2-1-6-2-3\" data-name=\"term clause 3\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-3-1\" data-name=\"term title\">\n                                3. Llogaria dhe përgjegjësia e përdoruesit\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-3-2\" data-name=\"term content\">\n                                Ju jeni përgjegjës për saktësinë e të dhënave që jepni, ruajtjen e qasjes në llogari dhe çdo veprim të kryer përmes saj. Mos përdorni llogari të personave të tjerë, mos krijoni llogari mashtruese dhe njoftoni platformën nëse dyshoni për përdorim të paautorizuar.\n                            </p>\n                        </section>\n                        <section class=\"border-b border-slate-100 py-4 lg:pl-4\" data-kid=\"1-1-2-1-6-2-4\" data-name=\"term clause 4\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-4-1\" data-name=\"term title\">\n                                4. Raportimet dhe përmbajtja\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-4-2\" data-name=\"term content\">\n                                Raportimet duhet të jenë të sakta, të dobishme dhe të lidhura me interesin publik. Mos dërgoni akuza të pavërteta, spam, kërcënime, përmbajtje diskriminuese, të dhëna të ndjeshme të personave të tjerë ose materiale që shkelin të drejtat e autorit. Mos publikoni fotografi të personave pa arsye të ligjshme ose pa pëlqimin e tyre kur ai kërkohet.\n                            </p>\n                        </section>\n                        <section class=\"border-b border-slate-100 py-4 lg:pr-4\" data-kid=\"1-1-2-1-6-2-5\" data-name=\"term clause 5\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-5-1\" data-name=\"term title\">\n                                5. Moderimi dhe masat\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-5-2\" data-name=\"term content\">\n                                Platforma mund të fshehë, kufizojë ose heqë përmbajtje që shkel këto kushte, si dhe të pezullojë llogaritë që abuzojnë me shërbimin. Moderimi mund të bëhet nga ekipi përgjegjës dhe me mjete të automatizuara. Vendimet mund të rishikohen kur paraqiten informacione të reja.\n                            </p>\n                        </section>\n                        <section class=\"border-b border-slate-100 py-4 lg:pl-4\" data-kid=\"1-1-2-1-6-2-6\" data-name=\"term clause 6\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-6-1\" data-name=\"term title\">\n                                6. Privatësia dhe të dhënat\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-6-2\" data-name=\"term content\">\n                                Të dhënat përpunohen vetëm për funksionimin, sigurinë, verifikimin dhe përmirësimin e shërbimit, në përputhje me ligjin në fuqi. Mos vendosni në raportime fjalëkalime, numra dokumentesh, të dhëna bankare ose të dhëna shëndetësore që nuk janë të nevojshme. Raportimet publike mund të shfaqin vetëm informacionin e paraparë nga funksioni përkatës.\n                            </p>\n                        </section>\n                        <section class=\"border-b border-slate-100 py-4 lg:pr-4\" data-kid=\"1-1-2-1-6-2-7\" data-name=\"term clause 7\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-7-1\" data-name=\"term title\">\n                                7. Përmbajtja e përdoruesit\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-7-2\" data-name=\"term content\">\n                                Ju ruani të drejtat mbi materialin që ngarkoni. Duke e dërguar në platformë, i jepni platformës një të drejtë joekskluzive për ta ruajtur, shfaqur dhe përpunuar vetëm për funksionimin e shërbimeve, moderimin dhe komunikimin me institucionet.\n                            </p>\n                        </section>\n                        <section class=\"border-b border-slate-100 py-4 lg:pl-4\" data-kid=\"1-1-2-1-6-2-8\" data-name=\"term clause 8\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-8-1\" data-name=\"term title\">\n                                8. Shërbimet dhe disponueshmëria\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-8-2\" data-name=\"term content\">\n                                Ne synojmë që shërbimet të jenë të sakta dhe të disponueshme, por nuk garantojmë funksionim të pandërprerë, saktësi absolute të hartave ose përgjigje të institucioneve brenda një afati të caktuar. Për rrezik të menjëhershëm përdorni numrat zyrtarë të emergjencës.\n                            </p>\n                        </section>\n                        <section class=\"border-b border-slate-100 py-4 lg:pr-4\" data-kid=\"1-1-2-1-6-2-9\" data-name=\"term clause 9\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-9-1\" data-name=\"term title\">\n                                9. Reklamat dhe lidhjet e jashtme\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-9-2\" data-name=\"term content\">\n                                Përmbajtja e sponsorizuar shënohet qartë. Platforma nuk garanton produktet, shërbimet ose përmbajtjen e faqeve të palëve të treta dhe nuk mban përgjegjësi për veprimet tuaja në ato faqe.\n                            </p>\n                        </section>\n                        <section class=\"border-b border-slate-100 py-4 lg:pl-4\" data-kid=\"1-1-2-1-6-2-10\" data-name=\"term clause 10\">\n                            <h2 class=\"font-serif text-base font-black text-slate-900\" data-kid=\"1-1-2-1-6-2-10-1\" data-name=\"term title\">\n                                10. Ndryshimet dhe kontakti\n                            </h2>\n                            <p class=\"mt-2 text-[11px] leading-5 text-slate-600\" data-kid=\"1-1-2-1-6-2-10-2\" data-name=\"term content\">\n                                Këto kushte mund të përditësohen kur ndryshojnë shërbimet ose kërkesat ligjore. Versioni i fundit publikohet në këtë faqe. Për pyetje, raportim abuzimi ose kërkesë për rishikim, përdorni faqen Kontakt ose kanalet e publikuara nga platforma.\n                            </p>\n                        </section>\n                    </div>\n                    <div class=\"mt-5 flex items-center justify-between gap-4 border-t border-slate-100 pt-4 text-[10px] text-slate-500\" data-kid=\"1-1-2-1-6-3\" data-name=\"footer content section\">\n                        <span class=\"flex items-center gap-2\" data-kid=\"1-1-2-1-6-3-1\" data-name=\"security info text\">\n                            <i class=\"h-3.5 w-3.5 text-emerald-600\" data-kid=\"1-1-2-1-6-3-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\">\n                            </i>\n                            Dokumenti ruhet i qasshëm nga footer-i i navigimit.\n                        </span>\n                        <a class=\"font-extrabold text-blue-700\" data-kid=\"1-1-2-1-6-3-2\" data-name=\"contact link\" href=\"#\">\n                            Kontakto platformën\n                            <i class=\"inline h-3 w-3\" data-kid=\"1-1-2-1-6-3-2-1\" data-lucide=\"arrow-up-right\" data-name=\"external arrow icon\">\n                            </i>\n                        </a>\n                    </div>\n                </main>\n            </div>\n        </main>\n    </div>\n    <script>\n        window.addEventListener('DOMContentLoaded',function(){if(window.lucide){window.lucide.createIcons();}});\n    </script>\n</div>\n",
      "comments": [],
      "created": "2026-09-23T08:32:15.668218+00:00",
      "modified": "2026-09-23T08:33:02.786819+00:00",
      "id": "var_dc61fe978d14"
    },
    "var_9c61b69ec655": {
      "type": "variant",
      "label": "Recommended — Left Navigation + Terms Acceptance",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Merriweather:wght@700;900&display=swap');\n  .legal-page { font-family: 'Plus Jakarta Sans', sans-serif; }\n  .legal-page .editorial { font-family: 'Merriweather', Georgia, serif; }\n  .legal-page button:disabled { cursor: not-allowed; }\n</style>\n<div class=\"legal-page min-h-screen bg-[#f0f7ff] text-[#0f1e2e]\" data-kid=\"1\" data-name=\"legal page container\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\" data-name=\"page layout structure\">\n        <!-- Mobile fallback shell; no desktop TopBar is present. -->\n        <header class=\"lg:hidden fixed inset-x-0 top-0 z-40 flex h-16 items-center justify-between border-b border-white/10 bg-[#0f2a44] px-4 text-white shadow-lg\" data-kid=\"1-1-1\" data-name=\"mobile header bar\">\n            <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"mobile logo container\">\n                <div class=\"flex h-9 w-9 items-center justify-center rounded-xl bg-[#2563eb] text-sm font-extrabold\" data-kid=\"1-1-1-1-1\" data-name=\"mobile app icon\">\n                    Z\n                </div>\n                <div data-kid=\"1-1-1-1-2\" data-name=\"mobile app name container\">\n                    <div class=\"text-sm font-extrabold leading-tight\" data-kid=\"1-1-1-1-2-1\" data-name=\"mobile site name\">\n                        Zëri i Qytetarëve\n                    </div>\n                    <div class=\"text-[9px] text-blue-200\" data-kid=\"1-1-1-1-2-2\" data-name=\"mobile site slogan\">\n                        Republika e Kosovës\n                    </div>\n                </div>\n            </div>\n            <button aria-label=\"Hap menunë\" class=\"flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 bg-white/10\" data-kid=\"1-1-1-2\" data-name=\"mobile menu toggle button\">\n                <i class=\"h-5 w-5\" data-kid=\"1-1-1-2-1\" data-lucide=\"menu\" data-name=\"mobile menu icon\">\n                </i>\n            </button>\n        </header>\n        <!-- Primary navigation: one visible, scannable list. -->\n        <aside class=\"hidden lg:flex lg:w-[280px] lg:shrink-0 lg:flex-col lg:border-r lg:border-[#d1e4f2] lg:bg-white\" data-kid=\"1-1-2\" data-name=\"desktop sidebar navigation\">\n            <div class=\"flex items-center justify-between border-b border-white/10 bg-[#0f2a44] px-4 py-4 text-white\" data-kid=\"1-1-2-1\" data-name=\"sidebar header container\">\n                <div class=\"flex min-w-0 items-center gap-3\" data-kid=\"1-1-2-1-1\" data-name=\"sidebar logo container\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-[#2563eb] text-lg font-extrabold shadow-lg shadow-blue-950/20\" data-kid=\"1-1-2-1-1-1\" data-name=\"sidebar app icon\">\n                        Z\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-1-1-2\" data-name=\"sidebar app name container\">\n                        <div class=\"truncate text-[13px] font-extrabold\" data-kid=\"1-1-2-1-1-2-1\" data-name=\"sidebar site name\">\n                            Zëri i Qytetarëve\n                        </div>\n                        <div class=\"truncate text-[10px] text-blue-200\" data-kid=\"1-1-2-1-1-2-2\" data-name=\"sidebar site slogan\">\n                            Republika e Kosovës\n                        </div>\n                    </div>\n                </div>\n                <button aria-label=\"Palos sidebar-in\" class=\"flex h-7 w-7 items-center justify-center rounded-lg bg-white/10 text-blue-100\" data-kid=\"1-1-2-1-2\" data-name=\"sidebar collapse button\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-2-1-2-1\" data-lucide=\"chevron-left\" data-name=\"sidebar chevron icon\">\n                    </i>\n                </button>\n            </div>\n            <div class=\"border-b border-[#d1e4f2] p-3\" data-kid=\"1-1-2-2\" data-name=\"report action container\">\n                <a class=\"flex h-11 items-center justify-center gap-2 rounded-xl bg-[#2563eb] px-4 text-sm font-extrabold text-white shadow-lg shadow-blue-600/20\" data-kid=\"1-1-2-2-1\" data-name=\"report issue call-to-action link\" href=\"#raporto\">\n                    <i class=\"h-4 w-4\" data-kid=\"1-1-2-2-1-1\" data-lucide=\"pen-line\" data-name=\"report issue icon\">\n                    </i>\n                    <span data-kid=\"1-1-2-2-1-2\" data-name=\"report issue button label\">\n                        Raporto një problem\n                    </span>\n                </a>\n            </div>\n            <nav aria-label=\"Navigimi kryesor\" class=\"flex-1 overflow-y-auto px-3 py-4\" data-kid=\"1-1-2-3\" data-name=\"main navigation menu\">\n                <p class=\"mb-2 px-3 text-[10px] font-extrabold uppercase tracking-[0.18em] text-[#64748b]\" data-kid=\"1-1-2-3-1\" data-name=\"navigation group label\">\n                    Navigimi kryesor\n                </p>\n                <div class=\"space-y-1\" data-kid=\"1-1-2-3-2\" data-name=\"navigation list container\">\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-1\" data-name=\"homepage link\" href=\"#ballina\">\n                        <i class=\"h-[18px] w-[18px] text-[#64748b]\" data-kid=\"1-1-2-3-2-1-1\" data-lucide=\"house\" data-name=\"homepage icon\">\n                        </i>\n                        Ballina\n                    </a>\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-2\" data-name=\"report issue link\" href=\"#raporto\">\n                        <i class=\"h-[18px] w-[18px] text-[#2563eb]\" data-kid=\"1-1-2-3-2-2-1\" data-lucide=\"plus-circle\" data-name=\"report issue icon\">\n                        </i>\n                        Raporto\n                    </a>\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-3\" data-name=\"map link\" href=\"#harta\">\n                        <i class=\"h-[18px] w-[18px] text-[#64748b]\" data-kid=\"1-1-2-3-2-3-1\" data-lucide=\"map\" data-name=\"map icon\">\n                        </i>\n                        Harta\n                    </a>\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-4\" data-name=\"reports link\" href=\"#raportimet\">\n                        <i class=\"h-[18px] w-[18px] text-[#64748b]\" data-kid=\"1-1-2-3-2-4-1\" data-lucide=\"newspaper\" data-name=\"reports icon\">\n                        </i>\n                        Raportimet\n                    </a>\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-5\" data-name=\"health registry link\" href=\"#shendetesor\">\n                        <i class=\"h-[18px] w-[18px] text-emerald-600\" data-kid=\"1-1-2-3-2-5-1\" data-lucide=\"heart-pulse\" data-name=\"health registry icon\">\n                        </i>\n                        Regjistri Shëndetësor\n                    </a>\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-6\" data-name=\"statistics link\" href=\"#statistikat\">\n                        <i class=\"h-[18px] w-[18px] text-[#64748b]\" data-kid=\"1-1-2-3-2-6-1\" data-lucide=\"bar-chart-3\" data-name=\"statistics icon\">\n                        </i>\n                        Statistikat\n                    </a>\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-7\" data-name=\"public debate link\" href=\"#debati\">\n                        <i class=\"h-[18px] w-[18px] text-[#64748b]\" data-kid=\"1-1-2-3-2-7-1\" data-lucide=\"users-round\" data-name=\"public debate icon\">\n                        </i>\n                        Debati Publik\n                    </a>\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-8\" data-name=\"donations link\" href=\"#ndihma\">\n                        <i class=\"h-[18px] w-[18px] text-rose-500\" data-kid=\"1-1-2-3-2-8-1\" data-lucide=\"heart-handshake\" data-name=\"donations icon\">\n                        </i>\n                        Ndihma & Donacione\n                    </a>\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-9\" data-name=\"contacts link\" href=\"#numrat\">\n                        <i class=\"h-[18px] w-[18px] text-[#64748b]\" data-kid=\"1-1-2-3-2-9-1\" data-lucide=\"phone\" data-name=\"contacts icon\">\n                        </i>\n                        Numrat & Institucionet\n                    </a>\n                    <a class=\"flex min-h-10 items-center gap-3 rounded-xl px-3 text-sm font-bold text-[#334155] hover:bg-[#eff7ff]\" data-kid=\"1-1-2-3-2-10\" data-name=\"help center link\" href=\"#qendra\">\n                        <i class=\"h-[18px] w-[18px] text-[#64748b]\" data-kid=\"1-1-2-3-2-10-1\" data-lucide=\"life-buoy\" data-name=\"help center icon\">\n                        </i>\n                        Qendra e Ndihmës\n                    </a>\n                </div>\n                <div class=\"my-5 border-t border-[#e2edf6]\" data-kid=\"1-1-2-3-3\" data-name=\"navigation divider\">\n                </div>\n                <p class=\"mb-2 px-3 text-[10px] font-extrabold uppercase tracking-[0.18em] text-[#94a3b8]\" data-kid=\"1-1-2-3-4\" data-name=\"secondary navigation group label\">\n                    Më shumë\n                </p>\n                <div class=\"space-y-1\" data-kid=\"1-1-2-3-5\" data-name=\"secondary navigation list container\">\n                    <a class=\"flex min-h-9 items-center gap-3 rounded-lg px-3 text-xs font-semibold text-[#64748b] hover:bg-[#f8fbff]\" data-kid=\"1-1-2-3-5-1\" data-name=\"polls link\" href=\"#sondazhet\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-3-5-1-1\" data-lucide=\"vote\" data-name=\"polls icon\">\n                        </i>\n                        Sondazhet\n                    </a>\n                    <a class=\"flex min-h-9 items-center gap-3 rounded-lg px-3 text-xs font-semibold text-[#64748b] hover:bg-[#f8fbff]\" data-kid=\"1-1-2-3-5-2\" data-name=\"services link\" href=\"#sherbimet\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-3-5-2-1\" data-lucide=\"briefcase-business\" data-name=\"services icon\">\n                        </i>\n                        Shërbimet\n                    </a>\n                    <a class=\"flex min-h-9 items-center gap-3 rounded-lg px-3 text-xs font-semibold text-[#64748b] hover:bg-[#f8fbff]\" data-kid=\"1-1-2-3-5-3\" data-name=\"municipalities link\" href=\"#komunat\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-3-5-3-1\" data-lucide=\"building-2\" data-name=\"municipalities icon\">\n                        </i>\n                        Komunat\n                    </a>\n                    <a class=\"flex min-h-9 items-center gap-3 rounded-lg px-3 text-xs font-semibold text-[#64748b] hover:bg-[#f8fbff]\" data-kid=\"1-1-2-3-5-4\" data-name=\"contact page link\" href=\"#kontakt\">\n                        <i class=\"h-4 w-4\" data-kid=\"1-1-2-3-5-4-1\" data-lucide=\"mail\" data-name=\"contact page icon\">\n                        </i>\n                        Kontakt\n                    </a>\n                </div>\n                <div class=\"mt-5 border-t border-[#e2edf6] pt-4\" data-kid=\"1-1-2-3-6\" data-name=\"terms and conditions navigation item\">\n                    <a aria-current=\"page\" class=\"relative flex min-h-10 items-center gap-3 rounded-xl bg-[#eff7ff] px-3 text-sm font-extrabold text-[#1e40af] before:absolute before:inset-y-2 before:left-0 before:w-1 before:rounded-full before:bg-[#2563eb]\" data-kid=\"1-1-2-3-6-1\" data-name=\"terms and conditions active link\" href=\"#terms\">\n                        <i class=\"h-[18px] w-[18px] text-[#2563eb]\" data-kid=\"1-1-2-3-6-1-1\" data-lucide=\"shield-check\" data-name=\"terms and conditions icon\">\n                        </i>\n                        Kushtet e Përdorimit\n                    </a>\n                </div>\n            </nav>\n            <div class=\"border-t border-[#d1e4f2] bg-[#fbfdff] p-3\" data-kid=\"1-1-2-4\" data-name=\"sidebar footer panel\">\n                <label class=\"mb-1.5 block px-1 text-[10px] font-extrabold uppercase tracking-[0.16em] text-[#64748b]\" data-kid=\"1-1-2-4-1\" data-name=\"location label\">\n                    Zona juaj\n                </label>\n                <div class=\"relative\" data-kid=\"1-1-2-4-2\" data-name=\"location selector container\">\n                    <select class=\"h-10 w-full appearance-none rounded-xl border border-[#d1e4f2] bg-white px-3 pr-9 text-xs font-bold text-[#334155]\" data-kid=\"1-1-2-4-2-1\" data-name=\"location dropdown\">\n                        <option data-kid=\"1-1-2-4-2-1-1\" data-name=\"first location option\">\n                            Kosova (të gjitha komunat)\n                        </option>\n                        <option data-kid=\"1-1-2-4-2-1-2\" data-name=\"second location option\">\n                            Prishtinë\n                        </option>\n                        <option data-kid=\"1-1-2-4-2-1-3\" data-name=\"third location option\">\n                            Prizren\n                        </option>\n                    </select>\n                    <i class=\"pointer-events-none absolute right-3 top-3 h-4 w-4 text-[#64748b]\" data-kid=\"1-1-2-4-2-2\" data-lucide=\"chevron-down\" data-name=\"dropdown chevron icon\">\n                    </i>\n                </div>\n                <div class=\"mt-3 grid grid-cols-3 gap-1.5\" data-kid=\"1-1-2-4-3\" data-name=\"settings button group\">\n                    <button class=\"flex h-9 items-center justify-center rounded-lg border border-[#d1e4f2] bg-white text-[10px] font-extrabold text-[#475569]\" data-kid=\"1-1-2-4-3-1\" data-name=\"dark mode toggle\">\n                        <i class=\"mr-1 h-3.5 w-3.5 text-indigo-600\" data-kid=\"1-1-2-4-3-1-1\" data-lucide=\"moon\" data-name=\"dark mode icon\">\n                        </i>\n                        Natë\n                    </button>\n                    <button class=\"flex h-9 items-center justify-center rounded-lg border border-[#d1e4f2] bg-white text-[10px] font-extrabold text-[#475569]\" data-kid=\"1-1-2-4-3-2\" data-name=\"notification bell toggle\">\n                        <i class=\"mr-1 h-3.5 w-3.5 text-[#64748b]\" data-kid=\"1-1-2-4-3-2-1\" data-lucide=\"bell\" data-name=\"notification icon\">\n                        </i>\n                        Lejo\n                    </button>\n                    <button class=\"flex h-9 items-center justify-center rounded-lg border border-[#d1e4f2] bg-white text-[10px] font-extrabold text-[#475569]\" data-kid=\"1-1-2-4-3-3\" data-name=\"language toggle button\">\n                        AL\n                    </button>\n                </div>\n                <div class=\"mt-3 flex items-center gap-2 rounded-xl border border-[#d1e4f2] bg-white p-2.5\" data-kid=\"1-1-2-4-4\" data-name=\"user account summary\">\n                    <div class=\"flex h-8 w-8 items-center justify-center rounded-lg bg-[#334155] text-sm font-extrabold text-white\" data-kid=\"1-1-2-4-4-1\" data-name=\"user avatar placeholder\">\n                        M\n                    </div>\n                    <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-4-4-2\" data-name=\"user profile name container\">\n                        <p class=\"truncate text-xs font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-2-4-4-2-1\" data-name=\"user display name\">\n                            Mysafir #MUDEW\n                        </p>\n                        <p class=\"text-[10px] text-[#64748b]\" data-kid=\"1-1-2-4-4-2-2\" data-name=\"user session status\">\n                            Sesioni aktiv\n                        </p>\n                    </div>\n                    <i class=\"h-4 w-4 text-[#64748b]\" data-kid=\"1-1-2-4-4-3\" data-lucide=\"bell\" data-name=\"user notification icon\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 pb-24 lg:pb-10\" data-kid=\"1-1-3\" data-name=\"main page content area\">\n            <div class=\"mx-auto max-w-5xl px-4 pt-24 sm:px-6 lg:px-10 lg:pt-8\" data-kid=\"1-1-3-1\" data-name=\"content wrapper\">\n                <div class=\"mb-6 flex flex-wrap items-center justify-between gap-3 text-xs font-bold text-[#64748b]\" data-kid=\"1-1-3-1-1\" data-name=\"breadcrumb navigation bar\">\n                    <div class=\"flex items-center gap-2\" data-kid=\"1-1-3-1-1-1\" data-name=\"breadcrumb path container\">\n                        <span class=\"text-[#2563eb]\" data-kid=\"1-1-3-1-1-1-1\" data-name=\"parent page label\">\n                            Dokument ligjor\n                        </span>\n                        <i class=\"h-3.5 w-3.5\" data-kid=\"1-1-3-1-1-1-2\" data-lucide=\"chevron-right\" data-name=\"breadcrumb separator icon\">\n                        </i>\n                        <span data-kid=\"1-1-3-1-1-1-3\" data-name=\"current page label\">\n                            Kushtet e Përdorimit\n                        </span>\n                    </div>\n                    <span class=\"rounded-full border border-[#d1e4f2] bg-white px-3 py-1.5 text-[10px] font-extrabold uppercase tracking-[0.12em] text-[#64748b]\" data-kid=\"1-1-3-1-1-2\" data-name=\"last updated badge\">\n                        Përditësuar më 19 shtator 2026\n                    </span>\n                </div>\n                <section class=\"relative overflow-hidden rounded-[28px] bg-[#071322] px-6 py-8 text-white shadow-[0_24px_60px_-30px_rgba(15,42,68,0.6)] sm:px-10 sm:py-10\" data-kid=\"1-1-3-1-2\" data-name=\"hero section\">\n                    <div class=\"absolute -right-20 -top-24 h-72 w-72 rounded-full bg-[#1e40af]/30 blur-3xl\" data-kid=\"1-1-3-1-2-1\" data-name=\"hero decorative orb\">\n                    </div>\n                    <div class=\"relative max-w-3xl\" data-kid=\"1-1-3-1-2-2\" data-name=\"hero content wrapper\">\n                        <div class=\"mb-5 flex items-center gap-3\" data-kid=\"1-1-3-1-2-2-1\" data-name=\"hero header icon group\">\n                            <div class=\"flex h-12 w-12 items-center justify-center rounded-2xl bg-[#2563eb]\" data-kid=\"1-1-3-1-2-2-1-1\" data-name=\"hero icon container\">\n                                <i class=\"h-6 w-6\" data-kid=\"1-1-3-1-2-2-1-1-1\" data-lucide=\"gavel\" data-name=\"hero legal icon\">\n                                </i>\n                            </div>\n                            <span class=\"text-xs font-extrabold uppercase tracking-[0.2em] text-blue-200\" data-kid=\"1-1-3-1-2-2-1-2\" data-name=\"hero legal label\">\n                                Dokument ligjor\n                            </span>\n                        </div>\n                        <h1 class=\"editorial text-4xl font-black tracking-tight sm:text-5xl\" data-kid=\"1-1-3-1-2-2-2\" data-name=\"hero headline\">\n                            Kushtet e Përdorimit\n                        </h1>\n                        <p class=\"mt-4 max-w-2xl text-sm leading-7 text-slate-300 sm:text-base\" data-kid=\"1-1-3-1-2-2-3\" data-name=\"hero description text\">\n                            Rregullat që përcaktojnë përdorimin e sigurt, të drejtë dhe transparent të platformës Zëri i Qytetarëve.\n                        </p>\n                    </div>\n                </section>\n                <div class=\"mt-4 grid grid-cols-1 gap-3 sm:grid-cols-3\" data-kid=\"1-1-3-1-3\" data-name=\"features summary grid\">\n                    <div class=\"flex items-center gap-3 rounded-2xl border border-[#d1e4f2] bg-white p-4\" data-kid=\"1-1-3-1-3-1\" data-name=\"first feature card\">\n                        <i class=\"h-5 w-5 text-[#2563eb]\" data-kid=\"1-1-3-1-3-1-1\" data-lucide=\"file-check-2\" data-name=\"feature icon\">\n                        </i>\n                        <span class=\"text-xs font-extrabold\" data-kid=\"1-1-3-1-3-1-2\" data-name=\"feature label\">\n                            Të qarta dhe publike\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3 rounded-2xl border border-[#d1e4f2] bg-white p-4\" data-kid=\"1-1-3-1-3-2\" data-name=\"second feature card\">\n                        <i class=\"h-5 w-5 text-emerald-600\" data-kid=\"1-1-3-1-3-2-1\" data-lucide=\"shield-check\" data-name=\"feature icon\">\n                        </i>\n                        <span class=\"text-xs font-extrabold\" data-kid=\"1-1-3-1-3-2-2\" data-name=\"feature label\">\n                            Përdorim i sigurt\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-3 rounded-2xl border border-[#d1e4f2] bg-white p-4\" data-kid=\"1-1-3-1-3-3\" data-name=\"third feature card\">\n                        <i class=\"h-5 w-5 text-amber-600\" data-kid=\"1-1-3-1-3-3-1\" data-lucide=\"user-check\" data-name=\"feature icon\">\n                        </i>\n                        <span class=\"text-xs font-extrabold\" data-kid=\"1-1-3-1-3-3-2\" data-name=\"feature label\">\n                            Përgjegjësi qytetare\n                        </span>\n                    </div>\n                </div>\n                <article class=\"mt-6 rounded-[26px] border border-[#d1e4f2] bg-white p-6 shadow-[0_18px_40px_-32px_rgba(30,64,175,0.7)] sm:p-10\" data-kid=\"1-1-3-1-4\" data-name=\"terms article content\">\n                    <div class=\"mb-9 flex items-start gap-3 rounded-2xl border border-blue-100 bg-blue-50 p-4 text-sm leading-6 text-blue-900\" data-kid=\"1-1-3-1-4-1\" data-name=\"warning notice block\">\n                        <i class=\"mt-0.5 h-5 w-5 shrink-0 text-[#2563eb]\" data-kid=\"1-1-3-1-4-1-1\" data-lucide=\"info\" data-name=\"info icon\">\n                        </i>\n                        <p data-kid=\"1-1-3-1-4-1-2\" data-name=\"warning notice text\">\n                            Ju lutemi lexoni këto kushte para se të raportoni, komentoni ose përdorni shërbimet e platformës.\n                        </p>\n                    </div>\n                    <div class=\"space-y-8\" data-kid=\"1-1-3-1-4-2\" data-name=\"legal terms section list\">\n                        <section data-kid=\"1-1-3-1-4-2-1\" data-name=\"first terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-1-1\" data-name=\"terms section heading\">\n                                1. Pranimi i kushteve\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-1-2\" data-name=\"terms section text\">\n                                Duke përdorur Zëri i Qytetarëve, ju pranoni këto Kushte të Përdorimit. Nëse nuk pajtoheni me to, mos përdorni shërbimet e platformës. Kushtet vlejnë për faqen, aplikacionet, hartën, regjistrin e raportimeve, forumin dhe shërbimet e lidhura.\n                            </p>\n                        </section>\n                        <section data-kid=\"1-1-3-1-4-2-2\" data-name=\"second terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-2-1\" data-name=\"terms section heading\">\n                                2. Qëllimi i platformës\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-2-2\" data-name=\"terms section text\">\n                                Platforma shërben për raportimin qytetar të problemeve publike, përcjelljen e statusit të tyre, pjesëmarrjen në diskutime dhe qasjen në informacione për komunat dhe institucionet. Platforma nuk zëvendëson kanalet zyrtare të emergjencës ose procedurat administrative.\n                            </p>\n                        </section>\n                        <section data-kid=\"1-1-3-1-4-2-3\" data-name=\"third terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-3-1\" data-name=\"terms section heading\">\n                                3. Llogaria dhe përgjegjësia e përdoruesit\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-3-2\" data-name=\"terms section text\">\n                                Ju jeni përgjegjës për saktësinë e të dhënave që jepni, ruajtjen e qasjes në llogari dhe çdo veprim të kryer përmes saj. Mos përdorni llogari të personave të tjerë, mos krijoni llogari mashtruese dhe njoftoni platformën nëse dyshoni për përdorim të paautorizuar.\n                            </p>\n                        </section>\n                        <section data-kid=\"1-1-3-1-4-2-4\" data-name=\"fourth terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-4-1\" data-name=\"terms section heading\">\n                                4. Raportimet dhe përmbajtja\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-4-2\" data-name=\"terms section text\">\n                                Raportimet duhet të jenë të sakta, të dobishme dhe të lidhura me interesin publik. Mos dërgoni akuza të pavërteta, spam, kërcënime, përmbajtje diskriminuese, të dhëna të ndjeshme të personave të tjerë ose materiale që shkelin të drejtat e autorit. Mos publikoni fotografi të personave pa arsye të ligjshme ose pa pëlqimin e tyre kur ai kërkohet.\n                            </p>\n                        </section>\n                        <section data-kid=\"1-1-3-1-4-2-5\" data-name=\"fifth terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-5-1\" data-name=\"terms section heading\">\n                                5. Moderimi dhe masat\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-5-2\" data-name=\"terms section text\">\n                                Platforma mund të fshehë, kufizojë ose heqë përmbajtje që shkel këto kushte, si dhe të pezullojë llogaritë që abuzojnë me shërbimin. Moderimi mund të bëhet nga ekipi përgjegjës dhe me mjete të automatizuara. Vendimet mund të rishikohen kur paraqiten informacione të reja.\n                            </p>\n                        </section>\n                        <section data-kid=\"1-1-3-1-4-2-6\" data-name=\"sixth terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-6-1\" data-name=\"terms section heading\">\n                                6. Privatësia dhe të dhënat\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-6-2\" data-name=\"terms section text\">\n                                Të dhënat përpunohen vetëm për funksionimin, sigurinë, verifikimin dhe përmirësimin e shërbimit, në përputhje me ligjin në fuqi. Mos vendosni në raportime fjalëkalime, numra dokumentesh, të dhëna bankare ose të dhëna shëndetësore që nuk janë të nevojshme. Raportimet publike mund të shfaqin vetëm informacionin e paraparë nga funksioni përkatës.\n                            </p>\n                        </section>\n                        <section data-kid=\"1-1-3-1-4-2-7\" data-name=\"seventh terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-7-1\" data-name=\"terms section heading\">\n                                7. Përmbajtja e përdoruesit\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-7-2\" data-name=\"terms section text\">\n                                Ju ruani të drejtat mbi materialin që ngarkoni. Duke e dërguar në platformë, i jepni platformës një të drejtë joekskluzive për ta ruajtur, shfaqur dhe përpunuar vetëm për funksionimin e shërbimeve, moderimin dhe komunikimin me institucionet.\n                            </p>\n                        </section>\n                        <section data-kid=\"1-1-3-1-4-2-8\" data-name=\"eighth terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-8-1\" data-name=\"terms section heading\">\n                                8. Shërbimet dhe disponueshmëria\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-8-2\" data-name=\"terms section text\">\n                                Ne synojmë që shërbimet të jenë të sakta dhe të disponueshme, por nuk garantojmë funksionim të pandërprerë, saktësi absolute të hartave ose përgjigje të institucioneve brenda një afati të caktuar. Për rrezik të menjëhershëm përdorni numrat zyrtarë të emergjencës.\n                            </p>\n                        </section>\n                        <section data-kid=\"1-1-3-1-4-2-9\" data-name=\"ninth terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-9-1\" data-name=\"terms section heading\">\n                                9. Reklamat dhe lidhjet e jashtme\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-9-2\" data-name=\"terms section text\">\n                                Përmbajtja e sponsorizuar shënohet qartë. Platforma nuk garanton produktet, shërbimet ose përmbajtjen e faqeve të palëve të treta dhe nuk mban përgjegjësi për veprimet tuaja në ato faqe.\n                            </p>\n                        </section>\n                        <section data-kid=\"1-1-3-1-4-2-10\" data-name=\"tenth terms section\">\n                            <h2 class=\"text-xl font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-4-2-10-1\" data-name=\"terms section heading\">\n                                10. Ndryshimet dhe kontakti\n                            </h2>\n                            <p class=\"mt-2 text-sm leading-7 text-[#64748b]\" data-kid=\"1-1-3-1-4-2-10-2\" data-name=\"terms section text\">\n                                Këto kushte mund të përditësohen kur ndryshojnë shërbimet ose kërkesat ligjore. Versioni i fundit publikohet në këtë faqe. Për pyetje, raportim abuzimi ose kërkesë për rishikim, përdorni faqen Kontakt ose kanalet e publikuara nga platforma.\n                            </p>\n                        </section>\n                    </div>\n                </article>\n                <!-- Clear legal consent: default unchecked/disabled plus a compact confirmed-state reference. -->\n                <section class=\"relative z-20 mt-6 rounded-[24px] border border-[#b9d6ef] bg-white/95 p-5 shadow-[0_20px_50px_-24px_rgba(15,42,68,0.45)] backdrop-blur sm:p-6\" data-kid=\"1-1-3-1-5\" data-name=\"consent confirmation section\">\n                    <div class=\"flex flex-col gap-5 xl:flex-row xl:items-center xl:justify-between\" data-kid=\"1-1-3-1-5-1\" data-name=\"consent layout container\">\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-1-3-1-5-1-1\" data-name=\"consent header container\">\n                            <div class=\"mb-1 flex items-center gap-2 text-[10px] font-extrabold uppercase tracking-[0.18em] text-[#2563eb]\" data-kid=\"1-1-3-1-5-1-1-1\" data-name=\"consent label container\">\n                                <i class=\"h-4 w-4\" data-kid=\"1-1-3-1-5-1-1-1-1\" data-lucide=\"clipboard-check\" data-name=\"clipboard icon\">\n                                </i>\n                                Pranimi i rregullave\n                            </div>\n                            <h2 class=\"text-lg font-extrabold text-[#0f1e2e]\" data-kid=\"1-1-3-1-5-1-1-2\" data-name=\"consent heading\">\n                                Jeni gati të vazhdoni?\n                            </h2>\n                            <label class=\"mt-3 flex cursor-pointer items-start gap-3 rounded-2xl border border-[#d1e4f2] bg-[#f8fbff] p-3.5\" data-kid=\"1-1-3-1-5-1-1-3\" data-name=\"consent checkbox wrapper\">\n                                <span class=\"mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-md border-2 border-[#94a3b8] bg-white\" data-kid=\"1-1-3-1-5-1-1-3-1\" data-name=\"checkbox visual target\">\n                                </span>\n                                <span class=\"text-sm font-semibold leading-6 text-[#334155]\" data-kid=\"1-1-3-1-5-1-1-3-2\" data-name=\"consent checkbox label\">\n                                    I kam lexuar dhe pranoj të gjitha Kushtet e Përdorimit dhe Rregullat e platformës.\n                                </span>\n                            </label>\n                            <p class=\"mt-2 text-[11px] font-semibold text-[#64748b]\" data-kid=\"1-1-3-1-5-1-1-4\" data-name=\"consent helper text\">\n                                Butoni aktivizohet pasi të zgjidhni kutinë e pranimit.\n                            </p>\n                        </div>\n                        <div class=\"w-full shrink-0 xl:w-[340px]\" data-kid=\"1-1-3-1-5-1-2\" data-name=\"consent action container\">\n                            <button class=\"flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#cbd5e1] px-5 text-sm font-extrabold text-[#64748b]\" data-kid=\"1-1-3-1-5-1-2-1\" data-name=\"consent submit button\" disabled=\"\">\n                                <i class=\"h-4 w-4\" data-kid=\"1-1-3-1-5-1-2-1-1\" data-lucide=\"lock-keyhole\" data-name=\"lock icon\">\n                                </i>\n                                Pranoj dhe vazhdoj\n                            </button>\n                            <div class=\"mt-3 flex items-center gap-2 rounded-xl border border-emerald-200 bg-emerald-50 px-3 py-2.5\" data-kid=\"1-1-3-1-5-1-2-2\" data-name=\"post-acceptance note\">\n                                <i class=\"h-4 w-4 shrink-0 text-emerald-600\" data-kid=\"1-1-3-1-5-1-2-2-1\" data-lucide=\"check-circle-2\" data-name=\"post-acceptance icon\">\n                                </i>\n                                <div data-kid=\"1-1-3-1-5-1-2-2-2\" data-name=\"post-acceptance text container\">\n                                    <p class=\"text-[11px] font-extrabold text-emerald-800\" data-kid=\"1-1-3-1-5-1-2-2-2-1\" data-name=\"post-acceptance title\">\n                                        Pas pranimit\n                                    </p>\n                                    <p class=\"text-[10px] font-semibold text-emerald-700\" data-kid=\"1-1-3-1-5-1-2-2-2-2\" data-name=\"post-acceptance description\">\n                                        Kutia shënohet dhe butoni bëhet aktiv.\n                                    </p>\n                                </div>\n                                <span class=\"ml-auto rounded-lg bg-emerald-600 px-2 py-1 text-[10px] font-extrabold text-white\" data-kid=\"1-1-3-1-5-1-2-2-3\" data-name=\"acceptance status badge\">\n                                    U pranua\n                                </span>\n                            </div>\n                        </div>\n                    </div>\n                </section>\n            </div>\n        </main>\n    </div>\n    <nav aria-label=\"Navigimi mobil\" class=\"lg:hidden fixed inset-x-3 bottom-3 z-40 flex h-16 items-center justify-around rounded-2xl border border-white/10 bg-[#0f172a]/95 px-2 text-white shadow-2xl backdrop-blur\" data-kid=\"1-2\" data-name=\"mobile bottom navigation\">\n        <a class=\"flex flex-col items-center gap-1 text-[10px] font-bold text-slate-300\" data-kid=\"1-2-1\" data-name=\"mobile home link\" href=\"#ballina\">\n            <i class=\"h-5 w-5\" data-kid=\"1-2-1-1\" data-lucide=\"house\" data-name=\"mobile home icon\">\n            </i>\n            Ballina\n        </a>\n        <a class=\"flex flex-col items-center gap-1 text-[10px] font-bold text-slate-300\" data-kid=\"1-2-2\" data-name=\"mobile map link\" href=\"#harta\">\n            <i class=\"h-5 w-5\" data-kid=\"1-2-2-1\" data-lucide=\"map\" data-name=\"mobile map icon\">\n            </i>\n            Harta\n        </a>\n        <a class=\"flex flex-col items-center gap-1 text-[10px] font-bold text-white\" data-kid=\"1-2-3\" data-name=\"mobile report link\" href=\"#raporto\">\n            <i class=\"h-5 w-5\" data-kid=\"1-2-3-1\" data-lucide=\"plus-circle\" data-name=\"mobile report icon\">\n            </i>\n            Raporto\n        </a>\n        <a class=\"flex flex-col items-center gap-1 text-[10px] font-bold text-slate-300\" data-kid=\"1-2-4\" data-name=\"mobile statistics link\" href=\"#statistikat\">\n            <i class=\"h-5 w-5\" data-kid=\"1-2-4-1\" data-lucide=\"bar-chart-3\" data-name=\"mobile statistics icon\">\n            </i>\n            Statistikat\n        </a>\n        <button class=\"flex flex-col items-center gap-1 text-[10px] font-bold text-slate-300\" data-kid=\"1-2-5\" data-name=\"mobile menu toggle button\">\n            <i class=\"h-5 w-5\" data-kid=\"1-2-5-1\" data-lucide=\"menu\" data-name=\"mobile menu icon\">\n            </i>\n            Menu\n        </button>\n    </nav>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
