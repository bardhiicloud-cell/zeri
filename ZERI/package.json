{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "prototype:server": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node scripts/start-prod.cjs",
    "check:lint": "node scripts/check-lint.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "i18n:check": "tsx scripts/i18n.ts check",
    "i18n:missing": "tsx scripts/i18n.ts missing",
    "i18n:import": "tsx scripts/i18n.ts import",
    "test": "vitest run tests/server tests/lib",
    "test:coverage": "vitest run tests/server tests/lib --coverage --coverage.include='server/**' --coverage.include='src/lib/**' --coverage.reporter=text-summary --coverage.thresholds.lines=45 --coverage.thresholds.functions=65 --coverage.thresholds.branches=84",
    "test:e2e": "playwright test",
    "test:workflow": "firebase emulators:exec --config firebase.workflow-test.json --only firestore,auth --project demo-zeri-workflow \"vitest run --no-file-parallelism tests/emulator/reportWorkflow.routes.test.ts tests/emulator/staffAccounts.test.ts\"",
    "test:rules": "firebase emulators:exec --config firebase.rules-test.json --only firestore,storage --project demo-zeri-rules \"vitest run --no-file-parallelism tests/rules tests/emulator --exclude tests/emulator/staffAccounts.test.ts\"",
    "claims:sync": "tsx scripts/sync-claims.ts",
    "mail:test": "tsx scripts/test-mail.ts",
    "matrix:write": "tsx scripts/write-permissions-matrix.ts"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.0.1",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/compression": "^1.8.1",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.15",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.13.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^12.42.2",
    "glob": "^13.0.6",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-ga4": "^3.0.1",
    "react-hot-toast": "^2.6.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.0",
    "sanitize-html": "^2.17.7",
    "tailwind-merge": "^3.5.0",
    "vite": "^6.2.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.56.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/express-rate-limit": "^5.1.3",
    "@types/hpp": "^0.2.7",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.14.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "firebase-tools": "^15.32.1",
    "jsdom": "^30.1.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "playwright-core": "1.56.1",
    "@grpc/grpc-js": "^1.14.6"
  }
}
