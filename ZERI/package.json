{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:admin-prototype": "node qa/run-admin-prototype.mjs",
    "prototype:seed": "tsx qa/seed-prototype-emulator.ts",
    "prototype:server": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "i18n:extract": "node extract_page_strings.js",
    "i18n:generate": "node generate_new_languages.js",
    "i18n:export": "node export_pending.js",
    "i18n:import": "node import_translations.js",
    "i18n:check": "node check_translations.js",
    "i18n:verify": "node qa/verify-i18n.mjs"
  },
  "dependencies": {
    "@google-cloud/translate": "^10.0.1",
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
