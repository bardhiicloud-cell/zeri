      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Merriweather:wght@400;700;900&display=swap');\n  :root { --page: #f0f7ff; --surface: #ffffff; --navy: #0f2a44; --blue: #1e40af; --blue-soft: #eff6ff; --border: #d1e4f2; --muted: #64748b; --text: #0f1e2e; --green: #16a34a; --amber: #d28a35; }\n  .zeri-page { font-family: 'Plus Jakarta Sans', sans-serif; background: var(--page); color: var(--text); }\n  .zeri-serif { font-family: 'Merriweather', Georgia, serif; }\n  .zeri-sidebar-scroll::-webkit-scrollbar { width: 5px; }\n  .zeri-sidebar-scroll::-webkit-scrollbar-thumb { background: #b9cde0; border-radius: 999px; }\n  .zeri-doc-scroll::-webkit-scrollbar { width: 7px; }\n  .zeri-doc-scroll::-webkit-scrollbar-thumb { background: #c6d9e8; border-radius: 999px; }\n</style>\n<div class=\"zeri-page min-h-screen flex\" data-kid=\"1\" data-name=\"page layout container\">\n    <aside class=\"w-[292px] shrink-0 min-h-screen sticky top-0 self-start bg-white border-r border-[#d1e4f2] flex flex-col\" data-kid=\"1-1\" data-name=\"sidebar navigation container\">\n        <div class=\"h-[78px] px-5 flex items-center justify-between bg-[#0f2a44] text-white border-b border-white/10\" data-kid=\"1-1-1\" data-name=\"sidebar header\">\n            <div class=\"flex items-center gap-3 min-w-0\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name container\">\n                <div class=\"w-10 h-10 rounded-xl bg-[#1e40af] flex items-center justify-center text-xl font-black shrink-0\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon\">\n                    Z\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-1-2\" data-name=\"brand name and subtitle container\">\n                    <div class=\"text-[13px] font-extrabold tracking-tight truncate\" data-kid=\"1-1-1-1-2-1\" data-name=\"brand name text\">\n                        Zëri Qytetarëve\n                    </div>\n                    <div class=\"text-[10px] text-blue-200 font-semibold truncate\" data-kid=\"1-1-1-1-2-2\" data-name=\"brand subtitle text\">\n                        Republika e Kosovës\n                    </div>\n                </div>\n            </div>\n            <button aria-label=\"Palos navigimin\" class=\"w-8 h-8 rounded-lg bg-white/10 flex items-center justify-center text-blue-100\" data-kid=\"1-1-1-2\" data-name=\"sidebar toggle button\">\n                <i class=\"w-4 h-4\" data-kid=\"1-1-1-2-1\" data-lucide=\"chevron-left\" data-name=\"chevron left icon\">\n                </i>\n            </button>\n        </div>\n        <div class=\"px-4 py-4 border-b border-[#e8f1f7]\" data-kid=\"1-1-2\" data-name=\"action button container\">\n            <button class=\"w-full rounded-xl bg-[#2563eb] hover:bg-[#1d4ed8] text-white min-h-[44px] flex items-center justify-center gap-2 text-[12px] font-extrabold shadow-[0_10px_22px_-14px_rgba(37,99,235,.9)]\" data-kid=\"1-1-2-1\" data-name=\"report issue button\">\n                <i class=\"w-4 h-4\" data-kid=\"1-1-2-1-1\" data-lucide=\"pen-square\" data-name=\"pen square icon\">\n                </i>\n                <span data-kid=\"1-1-2-1-2\" data-name=\"report issue button text\">\n                    Raporto një problem\n                </span>\n            </button>\n        </div>\n        <nav aria-label=\"Navigimi kryesor\" class=\"zeri-sidebar-scroll flex-1 overflow-y-auto px-3 py-4\" data-kid=\"1-1-3\" data-name=\"sidebar navigation menu\">\n            <div class=\"px-3 mb-2 text-[10px] uppercase tracking-[0.16em] font-extrabold text-[#94a9bb]\" data-kid=\"1-1-3-1\" data-name=\"navigation section label\">\n                Navigimi kryesor\n            </div>\n            <div class=\"space-y-1\" data-kid=\"1-1-3-2\" data-name=\"primary navigation links container\">\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-1\" data-name=\"home link\" href=\"#ballina\">\n                    <i class=\"w-[17px] h-[17px] text-[#2563eb]\" data-kid=\"1-1-3-2-1-2\" data-lucide=\"home\" data-name=\"home icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-1-3\" data-name=\"home link text\">\n                        Ballina\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-2\" data-name=\"report link\" href=\"#raporto\">\n                    <i class=\"w-[17px] h-[17px] text-[#2563eb]\" data-kid=\"1-1-3-2-2-1\" data-lucide=\"plus-circle\" data-name=\"plus circle icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-2-2\" data-name=\"report link text\">\n                        Raporto\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-3\" data-name=\"map link\" href=\"#harta\">\n                    <i class=\"w-[17px] h-[17px] text-[#2563eb]\" data-kid=\"1-1-3-2-3-1\" data-lucide=\"map\" data-name=\"map icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-3-2\" data-name=\"map link text\">\n                        Harta\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-4\" data-name=\"reports link\" href=\"#raportimet\">\n                    <i class=\"w-[17px] h-[17px] text-[#2563eb]\" data-kid=\"1-1-3-2-4-1\" data-lucide=\"newspaper\" data-name=\"newspaper icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-4-2\" data-name=\"reports link text\">\n                        Raportimet\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-5\" data-name=\"health registry link\" href=\"#regjistri\">\n                    <i class=\"w-[17px] h-[17px] text-[#0f9f88]\" data-kid=\"1-1-3-2-5-1\" data-lucide=\"heart-pulse\" data-name=\"health pulse icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-5-2\" data-name=\"health registry link text\">\n                        Regjistri Shëndetësor\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-6\" data-name=\"statistics link\" href=\"#statistikat\">\n                    <i class=\"w-[17px] h-[17px] text-[#2563eb]\" data-kid=\"1-1-3-2-6-1\" data-lucide=\"bar-chart-3\" data-name=\"bar chart icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-6-2\" data-name=\"statistics link text\">\n                        Statistikat\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-7\" data-name=\"public debate link\" href=\"#debati\">\n                    <i class=\"w-[17px] h-[17px] text-[#2563eb]\" data-kid=\"1-1-3-2-7-1\" data-lucide=\"users\" data-name=\"users icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-7-2\" data-name=\"public debate link text\">\n                        Debati Publik\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-8\" data-name=\"donations link\" href=\"#ndihma\">\n                    <i class=\"w-[17px] h-[17px] text-[#d28a35]\" data-kid=\"1-1-3-2-8-1\" data-lucide=\"heart-handshake\" data-name=\"heart handshake icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-8-2\" data-name=\"donations link text\">\n                        Ndihma & Donacione\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-9\" data-name=\"contacts link\" href=\"#numrat\">\n                    <i class=\"w-[17px] h-[17px] text-[#2563eb]\" data-kid=\"1-1-3-2-9-1\" data-lucide=\"phone\" data-name=\"phone icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-9-2\" data-name=\"contacts link text\">\n                        Numrat & Institucionet\n                    </span>\n                </a>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl text-[#273c50] hover:bg-[#f6faff] font-bold text-[12px]\" data-kid=\"1-1-3-2-10\" data-name=\"help center link\" href=\"#qendra\">\n                    <i class=\"w-[17px] h-[17px] text-[#2563eb]\" data-kid=\"1-1-3-2-10-1\" data-lucide=\"life-buoy\" data-name=\"life buoy icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-2-10-2\" data-name=\"help center link text\">\n                        Qendra e Ndihmës\n                    </span>\n                </a>\n            </div>\n            <div class=\"mt-6 pt-4 border-t border-[#e8f1f7]\" data-kid=\"1-1-3-3\" data-name=\"secondary navigation section\">\n                <div class=\"px-3 mb-2 text-[10px] uppercase tracking-[0.16em] font-extrabold text-[#94a9bb]\" data-kid=\"1-1-3-3-1\" data-name=\"secondary navigation label\">\n                    Më shumë\n                </div>\n                <div class=\"space-y-1\" data-kid=\"1-1-3-3-2\" data-name=\"secondary navigation links container\">\n                    <a class=\"flex items-center gap-3 min-h-[36px] px-3 rounded-xl text-[#64748b] hover:bg-[#f6faff] font-semibold text-[11px]\" data-kid=\"1-1-3-3-2-1\" data-name=\"municipalities link\" href=\"#komunat\">\n                        <i class=\"w-4 h-4\" data-kid=\"1-1-3-3-2-1-1\" data-lucide=\"building-2\" data-name=\"building icon\">\n                        </i>\n                        <span data-kid=\"1-1-3-3-2-1-2\" data-name=\"municipalities link text\">\n                            Komunat\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 min-h-[36px] px-3 rounded-xl text-[#64748b] hover:bg-[#f6faff] font-semibold text-[11px]\" data-kid=\"1-1-3-3-2-2\" data-name=\"services link\" href=\"#sherbimet\">\n                        <i class=\"w-4 h-4\" data-kid=\"1-1-3-3-2-2-1\" data-lucide=\"briefcase-business\" data-name=\"briefcase icon\">\n                        </i>\n                        <span data-kid=\"1-1-3-3-2-2-2\" data-name=\"services link text\">\n                            Shërbimet\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 min-h-[36px] px-3 rounded-xl text-[#64748b] hover:bg-[#f6faff] font-semibold text-[11px]\" data-kid=\"1-1-3-3-2-3\" data-name=\"news link\" href=\"#lajmet\">\n                        <i class=\"w-4 h-4\" data-kid=\"1-1-3-3-2-3-1\" data-lucide=\"megaphone\" data-name=\"megaphone icon\">\n                        </i>\n                        <span data-kid=\"1-1-3-3-2-3-2\" data-name=\"news link text\">\n                            Lajmet & Përditësimet\n                        </span>\n                    </a>\n                    <a class=\"flex items-center gap-3 min-h-[36px] px-3 rounded-xl text-[#64748b] hover:bg-[#f6faff] font-semibold text-[11px]\" data-kid=\"1-1-3-3-2-4\" data-name=\"contact link\" href=\"#kontakt\">\n                        <i class=\"w-4 h-4\" data-kid=\"1-1-3-3-2-4-1\" data-lucide=\"message-circle\" data-name=\"message bubble icon\">\n                        </i>\n                        <span data-kid=\"1-1-3-3-2-4-2\" data-name=\"contact link text\">\n                            Kontakt\n                        </span>\n                    </a>\n                </div>\n            </div>\n            <div class=\"mt-6 pt-4 border-t border-[#e8f1f7]\" data-kid=\"1-1-3-4\" data-name=\"legal section\">\n                <div class=\"px-3 mb-2 text-[10px] uppercase tracking-[0.16em] font-extrabold text-[#94a9bb]\" data-kid=\"1-1-3-4-1\" data-name=\"legal navigation label\">\n                    Ligjore\n                </div>\n                <a class=\"flex items-center gap-3 min-h-[40px] px-3 rounded-xl bg-[#0f2a44] text-white font-extrabold text-[11px]\" data-kid=\"1-1-3-4-2\" data-name=\"terms of service link\" href=\"#kushtet\">\n                    <i class=\"w-4 h-4 text-blue-200\" data-kid=\"1-1-3-4-2-1\" data-lucide=\"scale\" data-name=\"scale icon\">\n                    </i>\n                    <span data-kid=\"1-1-3-4-2-2\" data-name=\"terms of service link text\">\n                        Kushtet e Përdorimit\n                    </span>\n                </a>\n            </div>\n        </nav>\n        <div class=\"px-4 py-4 border-t border-[#d1e4f2] bg-[#fbfdff]\" data-kid=\"1-1-4\" data-name=\"sidebar user profile container\">\n            <div class=\"flex items-center gap-2 mb-3\" data-kid=\"1-1-4-1\" data-name=\"user info container\">\n                <div class=\"w-8 h-8 rounded-lg bg-[#e8f1f7] flex items-center justify-center text-[#1e40af] font-black text-xs\" data-kid=\"1-1-4-1-1\" data-name=\"user avatar placeholder\">\n                    M\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-4-1-2\" data-name=\"user status text container\">\n                    <div class=\"text-[11px] font-extrabold truncate\" data-kid=\"1-1-4-1-2-1\" data-name=\"user name text\">\n                        Mysafir #MUDEW\n                    </div>\n                    <div class=\"text-[10px] text-[#64748b]\" data-kid=\"1-1-4-1-2-2\" data-name=\"user status text\">\n                        Pa hyrje\n                    </div>\n                </div>\n            </div>\n            <div class=\"flex items-center justify-between gap-2\" data-kid=\"1-1-4-2\" data-name=\"sidebar settings button container\">\n                <button class=\"flex-1 h-8 rounded-lg border border-[#d1e4f2] bg-white text-[10px] font-extrabold text-[#64748b] flex items-center justify-center gap-1.5\" data-kid=\"1-1-4-2-1\" data-name=\"theme toggle button\">\n                    <i class=\"w-3.5 h-3.5 text-[#1e40af]\" data-kid=\"1-1-4-2-1-1\" data-lucide=\"moon\" data-name=\"moon icon\">\n                    </i>\n                    Natë\n                </button>\n                <button class=\"w-8 h-8 rounded-lg border border-[#d1e4f2] bg-white flex items-center justify-center text-[#64748b]\" data-kid=\"1-1-4-2-2\" data-name=\"notifications button\">\n                    <i class=\"w-3.5 h-3.5\" data-kid=\"1-1-4-2-2-1\" data-lucide=\"bell\" data-name=\"bell icon\">\n                    </i>\n                </button>\n                <button class=\"w-8 h-8 rounded-lg border border-[#d1e4f2] bg-white text-[10px] font-black text-[#64748b]\" data-kid=\"1-1-4-2-3\" data-name=\"language toggle button\">\n                    AL\n                </button>\n            </div>\n        </div>\n    </aside>\n    <main class=\"flex-1 min-w-0\" data-kid=\"1-2\" data-name=\"main content area\">\n        <div class=\"max-w-[1010px] mx-auto px-10 py-8\" data-kid=\"1-2-1\" data-name=\"page content wrapper\">\n            <div class=\"flex items-center justify-between mb-7\" data-kid=\"1-2-1-1\" data-name=\"breadcrumbs and status container\">\n                <div class=\"flex items-center gap-2 text-[11px] font-bold text-[#64748b]\" data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb path\">\n                    <span data-kid=\"1-2-1-1-1-1\" data-name=\"breadcrumb parent page\">\n                        Dokumentacioni qendror\n                    </span>\n                    <i class=\"w-3.5 h-3.5 text-[#9bb1c4]\" data-kid=\"1-2-1-1-1-2\" data-lucide=\"chevron-right\" data-name=\"chevron right icon\">\n                    </i>\n                    <span class=\"text-[#1e40af]\" data-kid=\"1-2-1-1-1-3\" data-name=\"breadcrumb current page\">\n                        Ligjore\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-2 text-[11px] font-semibold text-[#64748b]\" data-kid=\"1-2-1-1-2\" data-name=\"platform status container\">\n                    <span class=\"inline-flex w-2 h-2 rounded-full bg-[#16a34a]\" data-kid=\"1-2-1-1-2-1\" data-name=\"status indicator dot\">\n                    </span>\n                    Platforma aktive\n                    <span class=\"mx-1 text-[#c1d0dc]\" data-kid=\"1-2-1-1-2-2\" data-name=\"status separator\">\n                        •\n                    </span>\n                    SQ\n                </div>\n            </div>\n            <header class=\"relative overflow-hidden rounded-[28px] bg-[#071322] px-10 py-9 text-white shadow-[0_24px_60px_-30px_rgba(15,42,68,.55)]\" data-kid=\"1-2-1-2\" data-name=\"hero header card\">\n                <div class=\"absolute -right-20 -top-24 w-[360px] h-[360px] rounded-full bg-[#2563eb]/25 blur-3xl\" data-kid=\"1-2-1-2-1\" data-name=\"decorative blur orb top\">\n                </div>\n                <div class=\"absolute right-16 bottom-[-90px] w-[260px] h-[260px] rounded-full bg-[#0ea5e9]/10 blur-3xl\" data-kid=\"1-2-1-2-2\" data-name=\"decorative blur orb bottom\">\n                </div>\n                <div class=\"relative z-10 max-w-[680px]\" data-kid=\"1-2-1-2-3\" data-name=\"hero content container\">\n                    <div class=\"flex items-center gap-3 mb-5\" data-kid=\"1-2-1-2-3-1\" data-name=\"hero icon and badge container\">\n                        <div class=\"w-11 h-11 rounded-2xl bg-[#2563eb] flex items-center justify-center\" data-kid=\"1-2-1-2-3-1-1\" data-name=\"hero icon container\">\n                            <i class=\"w-5 h-5\" data-kid=\"1-2-1-2-3-1-1-1\" data-lucide=\"gavel\" data-name=\"gavel icon\">\n                            </i>\n                        </div>\n                        <span class=\"text-[11px] font-extrabold uppercase tracking-[0.22em] text-blue-200\" data-kid=\"1-2-1-2-3-1-2\" data-name=\"hero badge text\">\n                            Dokument ligjor\n                        </span>\n                    </div>\n                    <h1 class=\"zeri-serif text-[42px] leading-[1.12] font-black tracking-[-0.035em]\" data-kid=\"1-2-1-2-3-2\" data-name=\"hero headline text\">\n                        Kushtet e Përdorimit\n                    </h1>\n                    <p class=\"mt-4 text-[15px] leading-7 text-slate-300 max-w-[620px]\" data-kid=\"1-2-1-2-3-3\" data-name=\"hero description text\">\n                        Rregullat që përcaktojnë përdorimin e sigurt, të drejtë dhe transparent të platformës Zëri i Qytetarëve.\n                    </p>\n                    <div class=\"mt-6 flex items-center gap-2 text-[11px] font-semibold text-slate-400\" data-kid=\"1-2-1-2-3-4\" data-name=\"last updated date text\">\n                        <i class=\"w-3.5 h-3.5\" data-kid=\"1-2-1-2-3-4-1\" data-lucide=\"calendar-days\" data-name=\"calendar icon\">\n                        </i>\n                        Përditësuar më 19 shtator 2026\n                    </div>\n                </div>\n            </header>\n            <div class=\"grid grid-cols-3 gap-4 mt-5 mb-7\" data-kid=\"1-2-1-3\" data-name=\"stats highlights grid\">\n                <div class=\"bg-white border border-[#d1e4f2] rounded-2xl px-5 py-4 flex items-center gap-3 shadow-[0_12px_26px_-24px_rgba(30,64,175,.5)]\" data-kid=\"1-2-1-3-1\" data-name=\"highlight card one\">\n                    <div class=\"w-9 h-9 rounded-xl bg-[#eff6ff] text-[#1e40af] flex items-center justify-center\" data-kid=\"1-2-1-3-1-1\" data-name=\"highlight icon container one\">\n                        <i class=\"w-4.5 h-4.5\" data-kid=\"1-2-1-3-1-1-1\" data-lucide=\"file-check-2\" data-name=\"file check icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-[11px] font-extrabold text-[#273c50]\" data-kid=\"1-2-1-3-1-2\" data-name=\"highlight text one\">\n                        Të qarta dhe publike\n                    </span>\n                </div>\n                <div class=\"bg-white border border-[#d1e4f2] rounded-2xl px-5 py-4 flex items-center gap-3 shadow-[0_12px_26px_-24px_rgba(30,64,175,.5)]\" data-kid=\"1-2-1-3-2\" data-name=\"highlight card two\">\n                    <div class=\"w-9 h-9 rounded-xl bg-[#ecfdf5] text-[#16a34a] flex items-center justify-center\" data-kid=\"1-2-1-3-2-1\" data-name=\"highlight icon container two\">\n                        <i class=\"w-4.5 h-4.5\" data-kid=\"1-2-1-3-2-1-1\" data-lucide=\"shield-check\" data-name=\"shield check icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-[11px] font-extrabold text-[#273c50]\" data-kid=\"1-2-1-3-2-2\" data-name=\"highlight text two\">\n                        Përdorim i sigurt\n                    </span>\n                </div>\n                <div class=\"bg-white border border-[#d1e4f2] rounded-2xl px-5 py-4 flex items-center gap-3 shadow-[0_12px_26px_-24px_rgba(30,64,175,.5)]\" data-kid=\"1-2-1-3-3\" data-name=\"highlight card three\">\n                    <div class=\"w-9 h-9 rounded-xl bg-[#fff7ed] text-[#d28a35] flex items-center justify-center\" data-kid=\"1-2-1-3-3-1\" data-name=\"highlight icon container three\">\n                        <i class=\"w-4.5 h-4.5\" data-kid=\"1-2-1-3-3-1-1\" data-lucide=\"user-check\" data-name=\"user check icon\">\n                        </i>\n                    </div>\n                    <span class=\"text-[11px] font-extrabold text-[#273c50]\" data-kid=\"1-2-1-3-3-2\" data-name=\"highlight text three\">\n                        Përgjegjësi qytetare\n                    </span>\n                </div>\n            </div>\n            <article class=\"bg-white border border-[#d1e4f2] rounded-[28px] shadow-[0_18px_42px_-34px_rgba(30,64,175,.55)] overflow-hidden\" data-kid=\"1-2-1-4\" data-name=\"content article container\">\n                <div class=\"px-10 py-7 border-b border-[#e8f1f7] flex items-start gap-3 bg-[#fbfdff]\" data-kid=\"1-2-1-4-1\" data-name=\"article alert box\">\n                    <i class=\"w-5 h-5 mt-0.5 text-[#1e40af]\" data-kid=\"1-2-1-4-1-1\" data-lucide=\"info\" data-name=\"info icon\">\n                    </i>\n                    <p class=\"text-[13px] leading-6 text-[#36546e]\" data-kid=\"1-2-1-4-1-2\" data-name=\"alert text\">\n                        Ju lutemi lexoni këto kushte para se të raportoni, komentoni ose përdorni shërbimet e platformës.\n                    </p>\n                </div>\n                <div class=\"px-10 py-2\" data-kid=\"1-2-1-4-2\" data-name=\"terms sections list\">\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8 border-b border-[#e8f1f7]\" data-kid=\"1-2-1-4-2-1\" data-name=\"terms section 01\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-1-1\" data-name=\"section number\">\n                            01\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-1-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-1-2-1\" data-name=\"section title\">\n                                Pranimi i kushteve\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-1-2-2\" data-name=\"section body text\">\n                                Duke përdorur Zëri i Qytetarëve, ju pranoni këto Kushte të Përdorimit. Nëse nuk pajtoheni me to, mos përdorni shërbimet e platformës. Kushtet vlejnë për faqen, aplikacionet, hartën, regjistrin e raportimeve, forumin dhe shërbimet e lidhura.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8 border-b border-[#e8f1f7]\" data-kid=\"1-2-1-4-2-2\" data-name=\"terms section 02\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-2-1\" data-name=\"section number\">\n                            02\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-2-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-2-2-1\" data-name=\"section title\">\n                                Qëllimi i platformës\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-2-2-2\" data-name=\"section body text\">\n                                Platforma shërben për raportimin qytetar të problemeve publike, përcjelljen e statusit të tyre, pjesëmarrjen në diskutime dhe qasjen në informacione për komunat dhe institucionet. Platforma nuk zëvendëson kanalet zyrtare të emergjencës ose procedurat administrative.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8 border-b border-[#e8f1f7]\" data-kid=\"1-2-1-4-2-3\" data-name=\"terms section 03\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-3-1\" data-name=\"section number\">\n                            03\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-3-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-3-2-1\" data-name=\"section title\">\n                                Llogaria dhe përgjegjësia e përdoruesit\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-3-2-2\" data-name=\"section body text\">\n                                Ju jeni përgjegjës për saktësinë e të dhënave që jepni, ruajtjen e qasjes në llogari dhe çdo veprim të kryer përmes saj. Mos përdorni llogari të personave të tjerë, mos krijoni llogari mashtruese dhe njoftoni platformën nëse dyshoni për përdorim të paautorizuar.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8 border-b border-[#e8f1f7]\" data-kid=\"1-2-1-4-2-4\" data-name=\"terms section 04\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-4-1\" data-name=\"section number\">\n                            04\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-4-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-4-2-1\" data-name=\"section title\">\n                                Raportimet dhe përmbajtja\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-4-2-2\" data-name=\"section body text\">\n                                Raportimet duhet të jenë të sakta, të dobishme dhe të lidhura me interesin publik. Mos dërgoni akuza të pavërteta, spam, kërcënime, përmbajtje diskriminuese, të dhëna të ndjeshme të personave të tjerë ose materiale që shkelin të drejtat e autorit. Mos publikoni fotografi të personave pa arsye të ligjshme ose pa pëlqimin e tyre kur ai kërkohet.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8 border-b border-[#e8f1f7]\" data-kid=\"1-2-1-4-2-5\" data-name=\"terms section 05\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-5-1\" data-name=\"section number\">\n                            05\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-5-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-5-2-1\" data-name=\"section title\">\n                                Moderimi dhe masat\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-5-2-2\" data-name=\"section body text\">\n                                Platforma mund të fshehë, kufizojë ose heqë përmbajtje që shkel këto kushte, si dhe të pezullojë llogaritë që abuzojnë me shërbimin. Moderimi mund të bëhet nga ekipi përgjegjës dhe me mjete të automatizuara. Vendimet mund të rishikohen kur paraqiten informacione të reja.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8 border-b border-[#e8f1f7]\" data-kid=\"1-2-1-4-2-6\" data-name=\"terms section 06\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-6-1\" data-name=\"section number\">\n                            06\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-6-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-6-2-1\" data-name=\"section title\">\n                                Privatësia dhe të dhënat\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-6-2-2\" data-name=\"section body text\">\n                                Të dhënat përpunohen vetëm për funksionimin, sigurinë, verifikimin dhe përmirësimin e shërbimit, në përputhje me ligjin në fuqi. Mos vendosni në raportime fjalëkalime, numra dokumentesh, të dhëna bankare ose të dhëna shëndetësore që nuk janë të nevojshme. Raportimet publike mund të shfaqin vetëm informacionin e paraparë nga funksioni përkatës.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8 border-b border-[#e8f1f7]\" data-kid=\"1-2-1-4-2-7\" data-name=\"terms section 07\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-7-1\" data-name=\"section number\">\n                            07\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-7-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-7-2-1\" data-name=\"section title\">\n                                Përmbajtja e përdoruesit\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-7-2-2\" data-name=\"section body text\">\n                                Ju ruani të drejtat mbi materialin që ngarkoni. Duke e dërguar në platformë, i jepni platformës një të drejtë joekskluzive për ta ruajtur, shfaqur dhe përpunuar vetëm për funksionimin e shërbimeve, moderimin dhe komunikimin me institucionet.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8 border-b border-[#e8f1f7]\" data-kid=\"1-2-1-4-2-8\" data-name=\"terms section 08\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-8-1\" data-name=\"section number\">\n                            08\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-8-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-8-2-1\" data-name=\"section title\">\n                                Shërbimet dhe disponueshmëria\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-8-2-2\" data-name=\"section body text\">\n                                Ne synojmë që shërbimet të jenë të sakta dhe të disponueshme, por nuk garantojmë funksionim të pandërprerë, saktësi absolute të hartave ose përgjigje të institucioneve brenda një afati të caktuar. Për rrezik të menjëhershëm përdorni numrat zyrtarë të emergjencës.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8 border-b border-[#e8f1f7]\" data-kid=\"1-2-1-4-2-9\" data-name=\"terms section 09\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-9-1\" data-name=\"section number\">\n                            09\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-9-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-9-2-1\" data-name=\"section title\">\n                                Reklamat dhe lidhjet e jashtme\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-9-2-2\" data-name=\"section body text\">\n                                Përmbajtja e sponsorizuar shënohet qartë. Platforma nuk garanton produktet, shërbimet ose përmbajtjen e faqeve të palëve të treta dhe nuk mban përgjegjësi për veprimet tuaja në ato faqe.\n                            </p>\n                        </div>\n                    </section>\n                    <section class=\"grid grid-cols-[72px_1fr] gap-6 py-8\" data-kid=\"1-2-1-4-2-10\" data-name=\"terms section 10\">\n                        <div class=\"text-[12px] font-black tracking-[0.2em] text-[#8aa2b7] pt-1\" data-kid=\"1-2-1-4-2-10-1\" data-name=\"section number\">\n                            10\n                        </div>\n                        <div data-kid=\"1-2-1-4-2-10-2\" data-name=\"section content\">\n                            <h2 class=\"text-[21px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-4-2-10-2-1\" data-name=\"section title\">\n                                Ndryshimet dhe kontakti\n                            </h2>\n                            <p class=\"mt-3 text-[14px] leading-7 text-[#5d7182]\" data-kid=\"1-2-1-4-2-10-2-2\" data-name=\"section body text\">\n                                Këto kushte mund të përditësohen kur ndryshojnë shërbimet ose kërkesat ligjore. Versioni i fundit publikohet në këtë faqe. Për pyetje, raportim abuzimi ose kërkesë për rishikim, përdorni faqen Kontakt ose kanalet e publikuara nga platforma.\n                            </p>\n                        </div>\n                    </section>\n                </div>\n            </article>\n            <section class=\"mt-6 mb-12 rounded-[24px] border border-[#b9d3ea] bg-[#eef7ff] px-8 py-7 flex items-center justify-between gap-8 shadow-[0_16px_35px_-30px_rgba(30,64,175,.6)]\" data-kid=\"1-2-1-5\" data-name=\"terms acceptance section\">\n                <div class=\"flex items-start gap-4 max-w-[650px]\" data-kid=\"1-2-1-5-1\" data-name=\"acceptance content container\">\n                    <div class=\"w-11 h-11 rounded-2xl bg-white border border-[#c8deef] text-[#1e40af] flex items-center justify-center shrink-0\" data-kid=\"1-2-1-5-1-1\" data-name=\"acceptance icon container\">\n                        <i class=\"w-5 h-5\" data-kid=\"1-2-1-5-1-1-1\" data-lucide=\"check-circle-2\" data-name=\"check circle icon\">\n                        </i>\n                    </div>\n                    <div data-kid=\"1-2-1-5-1-2\" data-name=\"acceptance text container\">\n                        <h2 class=\"text-[18px] font-black text-[#0f1e2e]\" data-kid=\"1-2-1-5-1-2-1\" data-name=\"acceptance section title\">\n                            Pranimi i rregullave\n                        </h2>\n                        <p class=\"mt-1.5 text-[12px] leading-5 text-[#567188]\" data-kid=\"1-2-1-5-1-2-2\" data-name=\"acceptance description text\">\n                            Pa pranim të këtyre kushteve nuk mund të vazhdoni në pjesët e platformës që kërkojnë pajtim. Mund ta ndryshoni këtë zgjedhje vetëm nga cilësimet e llogarisë.\n                        </p>\n                        <label class=\"mt-4 flex items-center gap-3 cursor-pointer\" data-kid=\"1-2-1-5-1-2-3\" data-name=\"acceptance checkbox container\">\n                            <input checked=\"\" class=\"w-5 h-5 accent-[#1e40af] rounded border-[#9fbdd4]\" data-kid=\"1-2-1-5-1-2-3-1\" data-name=\"acceptance checkbox input\" type=\"checkbox\"/>\n                            <span class=\"text-[12px] font-extrabold text-[#273c50]\" data-kid=\"1-2-1-5-1-2-3-2\" data-name=\"acceptance label text\">\n                                I lexova, i kuptova dhe pajtohem me Kushtet e Përdorimit.\n                            </span>\n                        </label>\n                    </div>\n                </div>\n                <button class=\"shrink-0 min-w-[190px] h-12 rounded-xl bg-[#1e40af] hover:bg-[#1e3a8a] text-white text-[12px] font-extrabold flex items-center justify-center gap-2 shadow-[0_12px_24px_-14px_rgba(30,64,175,.9)]\" data-kid=\"1-2-1-5-2\" data-name=\"accept and continue button\">\n                    Pranoj dhe vazhdoj\n                    <i class=\"w-4 h-4\" data-kid=\"1-2-1-5-2-1\" data-lucide=\"arrow-right\" data-name=\"arrow right icon\">\n                    </i>\n                </button>\n            </section>\n        </div>\n    </main>\n</div>\n<script src=\"https://unpkg.com/lucide@latest\">\n</script>\n<script>\n    lucide.createIcons();\n</script>\n",
