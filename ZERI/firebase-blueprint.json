{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "role": { "type": "string", "enum": ["citizen", "admin", "agent"] },
        "points": { "type": "number" },
        "badges": { "type": "array", "items": { "type": "string" } },
        "avatar": { "type": "string" },
        "isBanned": { "type": "boolean" }
      },
      "required": ["name", "email", "role"]
    },
    "Report": {
      "title": "Report",
      "description": "Issue report details",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "urgency": { "type": "string", "enum": ["E ulët", "Mesatare", "E lartë", "Kritike"] },
        "location": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "address": { "type": "string" },
            "municipality": { "type": "string" }
          }
        },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["Draft", "Pending Review", "Approved", "Assigned", "In Progress", "Resolved", "Rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "upvotes": { "type": "number" },
        "commentsCount": { "type": "number" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "isAnonymous": { "type": "boolean" },
        "assignedTo": { "type": "string" },
        "timeline": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "status": { "type": "string" },
              "date": { "type": "string" },
              "comment": { "type": "string" },
              "updatedBy": { "type": "string" }
            }
          }
        }
      },
      "required": ["title", "description", "category", "urgency", "location", "status", "createdAt", "authorId", "authorName"]
    },
    "Comment": {
      "title": "Comment",
      "description": "Comment on a report",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "content": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["authorId", "authorName", "content", "createdAt"]
    },
    "Poll": {
      "title": "Poll",
      "description": "Poll details",
      "type": "object",
      "properties": {
        "question": { "type": "string" },
        "description": { "type": "string" },
        "image": { "type": "string" },
        "category": { "type": "string" },
        "municipality": { "type": "string" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" },
              "votes": { "type": "number" },
              "icon": { "type": "string" }
            }
          }
        },
        "totalVotes": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["question", "options", "totalVotes", "expiresAt", "createdBy"]
    },
    "ChatSession": {
      "title": "ChatSession",
      "description": "Support chat session",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "closed"] },
        "rating": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "userName", "status", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message in a support chat",
      "type": "object",
      "properties": {
        "sender": { "type": "string", "enum": ["ai", "user", "agent"] },
        "text": { "type": "string" },
        "time": { "type": "string", "format": "date-time" }
      },
      "required": ["sender", "text", "time"]
    },
    "LiveMessage": {
      "title": "LiveMessage",
      "description": "Public discussion message",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ip": { "type": "string" }
      },
      "required": ["userId", "userName", "text", "createdAt", "ip"]
    },
    "BannedIP": {
      "title": "BannedIP",
      "description": "Banned IP address",
      "type": "object",
      "properties": {
        "ip": { "type": "string" },
        "reason": { "type": "string" },
        "bannedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ip", "bannedAt"]
    },
    "Category": {
      "title": "Category",
      "description": "Report category",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "group": { "type": "string" }
      },
      "required": ["name"]
    },
    "BudgetAllocation": {
      "title": "BudgetAllocation",
      "description": "Participatory Budgeting allocations submitted by citizens",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "infrastructure": { "type": "number" },
        "environment": { "type": "number" },
        "education": { "type": "number" },
        "safety": { "type": "number" },
        "culture": { "type": "number" },
        "municipality": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["infrastructure", "environment", "education", "safety", "culture", "createdAt"]
    },
    "ForumPost": {
      "title": "ForumPost",
      "description": "Public discussion and debate posts",
      "type": "object",
      "properties": {
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "authorRole": { "type": "string" },
        "content": { "type": "string" },
        "category": { "type": "string" },
        "neighborhood": { "type": "string" },
        "likes": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" }
      },
      "required": ["authorId", "authorName", "content"]
    },
    "OfficialProfile": {
      "title": "OfficialProfile",
      "description": "Verified official institutional profiles",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "handle": { "type": "string" },
        "verified": { "type": "boolean" },
        "followers": { "type": "string" },
        "initials": { "type": "string" },
        "color": { "type": "string" }
      },
      "required": ["name", "handle"]
    }
  },
  "firestore": {
    "users": { "schema": "User", "description": "User profiles" },
    "reports": { "schema": "Report", "description": "Issue reports" },
    "reports/{reportId}/comments": { "schema": "Comment", "description": "Report comments" },
    "polls": { "schema": "Poll", "description": "Open polls" },
    "chats": { "schema": "ChatSession", "description": "Chat sessions" },
    "chats/{chatId}/messages": { "schema": "ChatMessage", "description": "Chat messages" },
    "liveMessages": { "schema": "LiveMessage", "description": "Public chat messages" },
    "bannedIPs": { "schema": "BannedIP", "description": "Banned IP list" },
    "categories": { "schema": "Category", "description": "Report categories" },
    "budgetAllocations": { "schema": "BudgetAllocation", "description": "Citizen participatory budgeting submissions" },
    "forumPosts": { "schema": "ForumPost", "description": "Forum discussions" },
    "officialProfiles": { "schema": "OfficialProfile", "description": "Official institutional profiles" }
  }
}
