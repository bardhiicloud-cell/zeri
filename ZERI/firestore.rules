rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ──────────────────────────────────────────────
    // Helper functions
    // ──────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    // Role checks via custom claims (set server-side via Admin SDK)
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    // Despite the name this is "admin or superadmin": the admin role is the
    // superadmin's operational deputy (see roleCatalog.ts). Use isOwner() for the
    // few things reserved to the superadmin alone.
    function isSuperAdmin() {
      return isAuthenticated() && (request.auth.token.admin == true || request.auth.token.superadmin == true);
    }

    function isOwner() {
      return isAuthenticated() && request.auth.token.superadmin == true;
    }

    /** Read-only oversight role. Grants reads below; no write rule mentions it. */
    function isMonitor() {
      return isAuthenticated() && request.auth.token.monitor == true;
    }

    function isApprover() {
      return isAuthenticated() && request.auth.token.approver == true;
    }

    function isAdsAdmin() {
      return isAuthenticated() && request.auth.token.adsadmin == true;
    }

    function isNewsAdmin() {
      return isAuthenticated() && request.auth.token.newsadmin == true;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.superadmin == true ||
        request.auth.token.approver == true ||
        request.auth.token.adsadmin == true ||
        request.auth.token.newsadmin == true ||
        request.auth.token.agent == true
      );
    }

    /**
     * Staff who may handle the health registry (special-category personal data).
     *
     * Mirrors the role table in src/lib/adminPermissions.ts: admins and
     * superadmins, approvers, and any account explicitly granted the `health`
     * section (`perm_health`, written by buildRoleClaims). `isStaff()` is too
     * broad here - it also covers ad and news editors and frontline agents, none
     * of whom have the health section.
     */
    function isHealthStaff() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.superadmin == true ||
        request.auth.token.approver == true ||
        request.auth.token.perm_health == true
      );
    }

    /**
     * Accounts that may read other people's profiles (name, email, phone).
     *
     * Profiles are personal data, and `isStaff()` is far too wide for them: it
     * includes frontline agents, approvers and ad/news editors, none of whom open
     * the citizen register or the staff console. Owner-level roles may; so may an
     * account explicitly granted one of the sections that list people (a grant
     * is written as a `perm_*` claim by buildRoleClaims).
     */
    function canReadUserDirectory() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.superadmin == true ||
        request.auth.token.perm_users == true ||
        request.auth.token.perm_agents == true ||
        request.auth.token.perm_monitoring == true ||
        request.auth.token.perm_monitorim == true ||
        request.auth.token.perm_moderim == true ||
        request.auth.token.perm_municipalities == true ||
        request.auth.token.perm_komunapanel == true
      );
    }

    /**
     * A paying municipality account.
     *
     * Deliberately NOT part of isStaff(). A municipality is a customer of the
     * transparency system, not platform staff, and it is the subject of the
     * reporting it would otherwise be able to see the whole of. Keeping it out
     * of isStaff() means every existing rule that grants staff access continues
     * to exclude it — which is the safe default.
     */
    function isMunicipality() {
      return isAuthenticated() && request.auth.token.municipality_account == true;
    }

    /** The municipality this account represents, from its token claim. */
    function ownMunicipality() {
      return request.auth.token.municipality;
    }

    /**
     * Statuses a municipal account may see.
     *
     * One boundary rather than a per-status list: from 'Approved' onward the
     * report is public record; before that it is unverified material about the
     * municipality itself, including complaints later dismissed. None of that
     * reaches the municipality it concerns.
     */
    function isMunicipalityVisibleStatus(status) {
      return status in ['Approved', 'Assigned', 'In Progress', 'Resolved', 'Overdue'];
    }

    // `.get('isBanned', false)` matters: profiles created by /api/v1/auth/sync have
    // no `isBanned` field, and reading the missing property directly raised an
    // evaluation error, which denied every write for that (non-banned) account.
    // A suspension (`suspendedUntil`, set by server/moderationCases.ts) ends on its own: once
    // its end has passed the account is treated as unrestricted even before the sweep clears it.
    function isBanned() {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && profile.get('isBanned', false) == true
        && (profile.get('suspendedUntil', null) == null || request.time < profile.suspendedUntil);
    }

    // Ensure a non-banned, authenticated user
    function canAct() {
      return isAuthenticated() && !isBanned();
    }

    function isGuest() {
      return isAuthenticated() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    /**
     * Fields on a user document that only the server may set. Keep in step with
     * `buildRoleClaims` and the admin routes in server.ts.
     */
    function privilegedUserFields() {
      return [
        'role', 'isBanned', 'points', 'isVerified', 'permissions', 'municipality',
        'municipalityPlan', 'badges', 'email', 'internalNote', 'passwordSetDirectly',
        'bannedAt', 'bannedBy', 'banReason', 'suspendedUntil', 'restriction', 'suspensionLiftedAt',
        'warningCount', 'lastWarningAt', 'lastWarningReason',
        'editorialClauseAcceptedAt', 'editorialClauseText',
        // Follows are written only by PUT/DELETE /api/v1/forum/follow/:uid so that
        // counters, blocks and notifications cannot be bypassed.
        'followingIds'
      ];
    }

    // ──────────────────────────────────────────────
    // Users collection — PII is private
    // ──────────────────────────────────────────────
    // Reading the whole users collection is forbidden outright. The old rule
    // said `allow read: if isAuthenticated()`, which let any citizen pull every
    // profile in the country in one call and exposed emails and phone numbers.
    // A user reads only their own document; staff read what their role needs.
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || canReadUserDirectory()
        // The manager of the agents watches staff, so may read staff and
        // municipal profiles - never a citizen's.
        || (isMonitor() && resource.data.role in [
             'agent', 'approver', 'newsadmin', 'adsadmin', 'responder', 'dispatcher',
             'moderator', 'monitor', 'municipality'
           ])
      );

      // A citizen creates their own profile on first sign-in. Privileged fields
      // are never client-assignable: the server (Admin SDK) is the only writer of
      // role, ban state, section permissions and municipality scope. Several of
      // these were once trusted by server.ts, so a self-written `permissions`
      // array was enough to act as an agent in the report pipeline.
      allow create: if (isAuthenticated() && request.auth.uid == userId
                        && request.resource.data.id == request.auth.uid
                        && !request.resource.data.keys().hasAny(privilegedUserFields()))
                    || isSuperAdmin();

      allow update: if isAuthenticated() && (
        (request.auth.uid == userId
         // Self-service: privileged fields are not self-assignable.
         && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(privilegedUserFields()))
        // An administrator may correct harmless fields (name, phone, notes). The
        // privileged ones - role, permissions, ban state, points, verification,
        // municipality - are written only by the server (Admin SDK), which checks
        // who may change what. Before this, `isAdmin()` could write any field on
        // any profile, which let an admin hand out roles without the superadmin-
        // only checks the role route enforces.
        || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(privilegedUserFields()))
      );

      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // Reports collection
    // ──────────────────────────────────────────────
    match /reports/{reportId} {
      // Anyone can look up a report by Track ID (public tracking).
      // PII (email) is not exposed in the TrackIdPage response.
      allow read: if true;

      // Anyone authenticated can create a report.
      // authorId MUST be the authenticated uid — no spoofing allowed.
      allow create: if canAct() &&
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.status == 'Pending Review' &&
                    request.resource.data.title is string &&
                    request.resource.data.description is string &&
                    request.resource.data.category is string &&
                    request.resource.data.location is map &&
                    request.resource.data.createdAt == request.time &&
                    // Pipeline state belongs to the server; a client-written timeline,
                    // assignment or counter would forge the public history of a report.
                    !request.resource.data.keys().hasAny(['timeline', 'assignedTo', 'resolvedAt', 'resolvedImage', 'upvotes', 'commentsCount']) &&
                    (!('trackingId' in request.resource.data) ||
                      (request.resource.data.trackingId is string && request.resource.data.trackingId.size() <= 40));

      // Update: the author may edit the *content* of their own still-pending
      // report; nobody may change the pipeline fields from the client.
      //
      // ── Why status/timeline are now denied to everyone ────────────────────
      //
      // The approval pipeline (agent → municipality → staff) is a set of gates.
      // It was enforced only in the UI, so any client holding a staff token
      // could write `status: 'Resolved'` straight to Firestore and skip every
      // gate. Moving the state machine to `POST /api/v1/reports/:id/transition`
      // means these fields must not be writable here at all — the endpoint uses
      // the Admin SDK, which bypasses these rules, so a legitimate transition is
      // unaffected while a direct write is refused.
      allow update: if isAuthenticated() && !isBanned() && (
        (
          resource.data.authorId == request.auth.uid
          && resource.data.status in ['Draft', 'Pending Review']
          && request.resource.data.status == resource.data.status
          && request.resource.data.authorId == resource.data.authorId
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'status', 'timeline', 'assignedTo', 'resolvedAt', 'resolvedImage',
            'upvotes', 'commentsCount', 'authorId', 'createdAt'
          ])
        )
        || isSuperAdmin()
      );

      allow delete: if isSuperAdmin();

      match /comments/{commentId} {
        // Only show comments on reports visible to the reader
        allow read: if true;
        allow create: if canAct() &&
                      request.resource.data.authorId == request.auth.uid &&
                      request.resource.data.content is string &&
                      request.resource.data.createdAt == request.time;
        allow update, delete: if isCommentOwnerOrStaff();
      }
    }

    /**
     * Retained for the read path and for the create rule's neighbour, but no
     * longer used to authorise a write: status changes go through the server.
     */
    function isReportOwnerOrStaff() {
      return (isAuthenticated() && !isBanned() && (
        resource.data.authorId == request.auth.uid ||
        request.auth.token.admin == true ||
        request.auth.token.approver == true ||
        request.auth.token.superadmin == true
      ));
    }

    function isCommentOwnerOrStaff() {
      return (isAuthenticated() && !isBanned() && (
        resource.data.authorId == request.auth.uid ||
        isAdmin()
      ));
    }

    // ──────────────────────────────────────────────
    // Polls
    // ──────────────────────────────────────────────
    // Vote counters are written only by the server's vote transaction
    // (POST /api/v1/polls/:id/vote, server/polls.ts), which also records one
    // `votes/{uid}` document per account. The previous rule let any signed-in or
    // guest user replace the whole `options` array, so a single request could set
    // any result, and "already voted" was only a localStorage flag.
    match /polls/{pollId} {
      allow read: if true;
      allow create: if isAdmin() || isNewsAdmin();
      allow update: if isAdmin() || isNewsAdmin();
      allow delete: if isSuperAdmin();

      // A voter may see their own ballot record (to know they already voted on
      // another device); nobody can write one from a client.
      match /votes/{voterId} {
        allow read: if isAuthenticated() && request.auth.uid == voterId;
        allow write: if false;
      }
    }

    // Published news is public; drafts and editorial writes are restricted.
    match /newsArticles/{articleId} {
      allow read: if resource.data.published == true ||
                  isNewsAdmin() || isAdmin() || isSuperAdmin();
      // Editors write the text. Going public, or coming down, is a decision taken
      // through POST /api/v1/admin/decisions/news/:id, which records who and why;
      // so a client may create only drafts and may never flip `published` itself.
      allow create: if (isNewsAdmin() || isAdmin() || isSuperAdmin()) &&
                    request.resource.data.title is string &&
                    request.resource.data.summary is string &&
                    request.resource.data.content is string &&
                    request.resource.data.category is string &&
                    request.resource.data.published == false;
      allow update: if (isNewsAdmin() || isAdmin() || isSuperAdmin()) &&
                    request.resource.data.title is string &&
                    request.resource.data.summary is string &&
                    request.resource.data.content is string &&
                    request.resource.data.category is string &&
                    request.resource.data.published == resource.data.published;
      allow delete: if isNewsAdmin() || isAdmin() || isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // Ads — admin-only writes
    // ──────────────────────────────────────────────
    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if isAdsAdmin() || isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // Notifications — public broadcasts or recipient-only private messages
    // ──────────────────────────────────────────────
    // A broadcast carries a lifecycle `state` (draft/published/archived/
    // disabled). Legacy documents have no `state` and are treated as published
    // so nothing disappears on upgrade. Only published broadcasts are world
    // readable; staff see every state so they can manage the queue.
    function isPublishedBroadcast(data) {
      return data.audience == 'all' &&
             (!('state' in data) || data.state == 'published');
    }

    match /notifications/{notificationId} {
      allow read: if isPublishedBroadcast(resource.data) ||
                  (isAuthenticated() &&
                   (resource.data.userId == request.auth.uid || isStaff()));
      // Citizens notify each other only about forum activity (a reply, a repost, a
      // direct message) and only with an in-app link. The previous rule accepted any
      // `audience: 'user'` document with the caller as actor, so anyone could send
      // any user a notification with an arbitrary title, message and external link:
      // an in-app phishing channel.
      // Citizen-to-citizen notifications (replies, likes, mentions, quotes, follows,
      // direct messages) are created ONLY by the server after it has verified the
      // action (server/forumPosts.ts, server/directMessages.ts). A citizen can no
      // longer write a notification into another person's bell.
      allow create: if canAct() && (isAdmin() || isStaff());
      allow update: if (isAuthenticated() && resource.data.userId == request.auth.uid) ||
                      isAdmin() || isStaff();
      allow delete: if isAdmin() || isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // Per-user read state for public broadcasts
    // ──────────────────────────────────────────────
    // A broadcast document is shared by everyone, so "read" cannot live on it.
    // Each reader owns a tiny `${uid}_${notificationId}` marker. This scales to
    // millions of readers without ever writing to the broadcast itself, and the
    // bell queries only the current user's markers.
    match /notificationReads/{readId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.notificationId is string;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // ──────────────────────────────────────────────
    // Report lifecycle events — cross-report activity feed
    // ──────────────────────────────────────────────
    // Written only by the server transition endpoint (Admin SDK), which bypasses
    // these rules; clients may never forge an event. Public events feed the news
    // sidebar's live commune-response activity; staff see the full history.
    match /report_events/{eventId} {
      allow read: if resource.data.isPublic == true || isStaff() || isMonitor();
      allow create, update, delete: if false;
    }

    // Support requests — registered citizens can start a bot session and request an agent.
    // The requester can see their own conversation; support staff handle replies.
    // Support desk (server/supportDesk.ts). A citizen reads and writes their own conversation.
    // A support agent reads the waiting queue and the conversations THEY accepted; once a
    // colleague accepts one it is no longer readable by the others. Agents change nothing
    // from the browser: accepting, replying, transferring and closing go through the server.
    function isSupportStaff() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        request.auth.token.agent == true ||
        request.auth.token.approver == true ||
        request.auth.token.perm_support == true
      );
    }

    match /supportChats/{chatId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isSuperAdmin() ||
        (isSupportStaff() && (resource.data.status == 'waiting_agent' || resource.data.get('assignedTo', null) == request.auth.uid))
      );
      allow create: if canAct() && !isGuest() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.status in ['bot', 'waiting_agent'] &&
                    request.resource.data.get('assignedTo', null) == null;
      // The citizen adds messages and may ask for an agent (bot/resolved -> waiting_agent).
      // They cannot pick, keep or remove an agent, or close the conversation themselves.
      allow update: if isAuthenticated() &&
                    resource.data.userId == request.auth.uid &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'messages', 'updatedAt', 'status', 'agentTrackId', 'agentRequestedAt', 'department',
                      'assignedTo', 'assignedAgentName', 'userName', 'userEmail'
                    ]) &&
                    (request.resource.data.status == resource.data.status ||
                      (request.resource.data.status == 'waiting_agent' && resource.data.status in ['bot', 'resolved'])) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['assignedTo', 'assignedAgentName']) ||
                      (request.resource.data.status == 'waiting_agent' && request.resource.data.get('assignedTo', null) == null));
      allow delete: if isSuperAdmin();

      // Who accepted, transferred or closed it, and why. Server-written only.
      match /events/{eventId} {
        allow read: if isSuperAdmin();
        allow write: if false;
      }
    }

    // ──────────────────────────────────────────────
    // Categories — public read, admin write
    // ──────────────────────────────────────────────
    match /categories/{categoryId} {
      allow read: if true;
      // Admins, approvers (who own the geography and routing section) and any
      // account granted it. Not every staff role: a frontline agent could
      // otherwise reroute every category's reports.
      allow create, update, delete: if isSuperAdmin() || isApprover()
                                    || (isAuthenticated() && request.auth.token.perm_categories == true);
    }

    // ──────────────────────────────────────────────
    // Donation Causes — public read, admin write
    // ──────────────────────────────────────────────
    match /donationCauses/{causeId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // Forum Posts — authenticated create, ownership-based write
    // ──────────────────────────────────────────────
    match /forumStories/{storyId} {
      // Hiding is enforced here, not just in the app. A single story is readable by
      // the public only while visible AND live (get checks the server clock).
      // A LIST query cannot be checked against the clock — Firestore cannot prove a
      // client-supplied bound against request.time — so lists enforce `isHidden ==
      // false` and the app's query adds the `expiresAt` bound (ForumStories.tsx).
      // Consequence, stated plainly: a hand-written list query can still enumerate
      // expired-but-not-hidden stories; it can never read hidden ones. Authors keep
      // access to their own stories and staff to all of them.
      allow get: if (resource.data.isHidden == false && resource.data.expiresAt > request.time)
                 || (isAuthenticated() && resource.data.authorId == request.auth.uid)
                 || isStaff();
      allow list: if resource.data.isHidden == false
                  || (isAuthenticated() && resource.data.authorId == request.auth.uid)
                  || isStaff();
      allow create: if canAct() &&
                    !isGuest() &&
                    request.resource.data.isHidden == false &&
                    request.resource.data.get('status', 'published') == 'published' &&
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.authorName is string &&
                    request.resource.data.mediaUrl is string &&
                    request.resource.data.mediaType in ['image', 'video'] &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.expiresAt is timestamp &&
                    request.resource.data.expiresAt > request.time &&
                    request.resource.data.keys().hasOnly([
                      'authorId', 'authorName', 'authorAvatar', 'mediaUrl',
                      'mediaType', 'textOverlay', 'effect', 'createdAt', 'expiresAt', 'isHidden',
                      // Live story-editor fields (overlay placement + styling).
                      'overlayX', 'overlayY', 'overlayColor', 'overlaySize',
                      // Full editor: image adjustments, layers, badges, links,
                      // and the draft/publish/schedule lifecycle.
                      'adjustments', 'filters', 'layers', 'stickers', 'gradient',
                      'font', 'hashtags', 'mentions', 'link', 'logo', 'badge',
                      'status', 'scheduledAt', 'publishedAt', 'title'
                    ]);
      // The author may edit their own story (Save Draft → Publish, reschedule);
      // staff (moderators/agents) may hide or annotate any story. Authorship and
      // timestamps are fixed for everyone, so moderation can only add flags.
      // An author cannot lift a moderator's hide or push the expiry out: those keys
      // are staff-only (hiding) or fixed at creation (expiry).
      allow update: if isAuthenticated() && !isBanned() && (
        (resource.data.authorId == request.auth.uid
         && !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(['authorId', 'createdAt', 'expiresAt', 'isHidden', 'hiddenBy', 'hiddenAt', 'hiddenReason']))
        || isStaff()
      );
      allow delete: if isAuthenticated() &&
                    (resource.data.authorId == request.auth.uid || isStaff());
    }

    // ──────────────────────────────────────────────
    // Forum Reels — short vertical videos (src/lib/reels.ts). Unlike stories
    // they do not expire. Media lives in Storage forum_reels/{uid}/…
    // ──────────────────────────────────────────────
    match /forumReels/{reelId} {
      // Public while not hidden by moderation. List queries must filter
      // isHidden == false. Authors and staff can still open hidden reels.
      allow read: if resource.data.isHidden == false
                  || isStaff()
                  || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      allow create: if canAct() &&
                    !isGuest() &&
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.authorName is string &&
                    request.resource.data.authorName.size() <= 120 &&
                    request.resource.data.mediaUrl is string &&
                    request.resource.data.mediaPath is string &&
                    request.resource.data.mediaPath.matches('forum_reels/' + request.auth.uid + '/.+') &&
                    request.resource.data.mediaType == 'video' &&
                    // Optional cover frame and music credit set by the editor.
                    (!('coverUrl' in request.resource.data) ||
                      (request.resource.data.coverUrl is string &&
                       request.resource.data.coverPath is string &&
                       request.resource.data.coverPath.matches('forum_reels/' + request.auth.uid + '/.+'))) &&
                    (!('audioTitle' in request.resource.data) ||
                      (request.resource.data.audioTitle is string && request.resource.data.audioTitle.size() <= 80)) &&
                    request.resource.data.caption is string &&
                    request.resource.data.caption.size() <= 300 &&
                    request.resource.data.hashtags is list &&
                    request.resource.data.hashtags.size() <= 10 &&
                    request.resource.data.durationSec is number &&
                    request.resource.data.durationSec > 0 &&
                    request.resource.data.durationSec <= 91 &&
                    request.resource.data.isHidden == false &&
                    request.resource.data.likedBy == [] &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.keys().hasOnly([
                      'authorId', 'authorName', 'authorAvatar', 'mediaUrl', 'mediaPath',
                      'coverUrl', 'coverPath', 'audioTitle',
                      'mediaType', 'caption', 'hashtags', 'durationSec', 'isHidden',
                      'likedBy', 'createdAt'
                    ]);

      allow update: if canAct() && (
        // Like: exactly the caller's uid is added. Counters cannot be inflated.
        (!isGuest() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']) &&
         request.resource.data.likedBy.hasAll(resource.data.likedBy) &&
         request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1 &&
         request.auth.uid in request.resource.data.likedBy)
        ||
        // Unlike: exactly the caller's uid is removed.
        (!isGuest() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy']) &&
         resource.data.likedBy.hasAll(request.resource.data.likedBy) &&
         request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1 &&
         request.auth.uid in resource.data.likedBy &&
         !(request.auth.uid in request.resource.data.likedBy))
        ||
        // The author may edit the caption only.
        (resource.data.authorId == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['caption', 'hashtags']) &&
         request.resource.data.caption is string &&
         request.resource.data.caption.size() <= 300)
        ||
        // Staff moderation: hide/restore with a reason; nothing else.
        (isStaff() &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['isHidden', 'hiddenReason', 'hiddenBy', 'hiddenAt']) &&
         request.resource.data.isHidden is bool)
      );

      // Authors delete through DELETE /api/v1/forum/reels/:id, which also removes the
      // video and cover from Storage, the comments and the reports. Staff may delete directly.
      allow delete: if isStaff();

      // Comments follow the reel: readable while it is visible. Authors write
      // and remove their own; staff can remove any. Comments are never edited.
      match /comments/{commentId} {
        allow read: if get(/databases/$(database)/documents/forumReels/$(reelId)).data.isHidden == false
                    || isStaff();
        allow create: if canAct() &&
                      !isGuest() &&
                      get(/databases/$(database)/documents/forumReels/$(reelId)).data.isHidden == false &&
                      request.resource.data.authorId == request.auth.uid &&
                      request.resource.data.authorName is string &&
                      request.resource.data.authorName.size() <= 120 &&
                      request.resource.data.text is string &&
                      request.resource.data.text.size() > 0 &&
                      request.resource.data.text.size() <= 300 &&
                      request.resource.data.createdAt == request.time &&
                      request.resource.data.keys().hasOnly(['authorId', 'authorName', 'authorAvatar', 'text', 'createdAt']);
        allow update: if false;
        allow delete: if isAuthenticated() &&
                      (resource.data.authorId == request.auth.uid || isStaff());
      }
    }

    // Reel reports: one per (reel, reporter) — the document id enforces it.
    // Only staff can read them; the reporter cannot see or alter the queue.
    // Scheduled posts live only on the server (it validates, lists and publishes them).
    match /forumScheduled/{id} {
      allow read, write: if false;
    }

    // Reports of comments, accounts and ads. Created only by the server (it checks the target
    // and stores a snapshot); staff read them and close them.
    match /forumReports/{reportId} {
      allow read: if isStaff();
      allow create: if false;
      allow update: if isStaff() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if isSuperAdmin();
    }

    match /forumReelReports/{reportId} {
      allow read: if isStaff();
      allow create: if canAct() &&
                    !isGuest() &&
                    reportId == request.resource.data.reelId + '_' + request.auth.uid &&
                    request.resource.data.reporterId == request.auth.uid &&
                    request.resource.data.reelId is string &&
                    request.resource.data.reason in ['spam', 'abuse', 'misinformation', 'violence', 'privacy', 'other'] &&
                    request.resource.data.details is string &&
                    request.resource.data.details.size() <= 300 &&
                    request.resource.data.status == 'open' &&
                    request.resource.data.createdAt == request.time &&
                    request.resource.data.keys().hasOnly(['reelId', 'reporterId', 'reason', 'details', 'status', 'createdAt']);
      allow update: if isStaff() &&
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt']);
      allow delete: if isSuperAdmin();
    }

    match /forumPosts/{postId} {
      // Public posts are readable by everyone; a followers-only post only by its author and
      // staff. Followers read those through GET /api/v1/forum/followers-feed, where the
      // server checks the follow relationship. List queries must filter
      // `visibility == 'public'` (or `authorId == me`); see scripts/backfill-post-visibility.ts
      // for posts written before the field was mandatory.
      allow read: if resource.data.visibility == 'public'
                  || (isAuthenticated() && resource.data.authorId == request.auth.uid)
                  || isStaff();
      // A new post starts empty: engagement, edit and delete state, counters and the
      // sponsored flag cannot be pre-seeded by the browser. Only ads staff may mark a
      // post as sponsored, and the author's e-mail is never stored on a public post.
      allow create: if canAct() &&
                    !isGuest() &&
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.content is string &&
                    request.resource.data.content.size() <= 5000 &&
                    request.resource.data.get('visibility', '') in ['public', 'followers'] &&
                    request.resource.data.get('likes', []) == [] &&
                    request.resource.data.get('reposts', []) == [] &&
                    request.resource.data.get('comments', []) == [] &&
                    request.resource.data.get('reactions', {}) == {} &&
                    (request.resource.data.get('poll', null) == null || request.resource.data.poll.totalVotes == 0) &&
                    !request.resource.data.keys().hasAny([
                      'deletedAt', 'deletedBy', 'editedAt', 'viewCount', 'adClicks', 'authorEmail', 'commentAuthorIds'
                    ]) &&
                    (request.resource.data.get('isAd', false) != true || isAdsAdmin());
      // Everything that changes an existing post goes through the server
      // (server/forumPosts.ts, POST …/action for likes and reposts, the admin
      // decision endpoint for moderation): comments, replies, reactions, poll
      // votes, edits, soft delete and restore are transactions there. The browser
      // can no longer rewrite those fields. Staff keep the narrow moderation edit.
      allow update: if isAuthenticated() && !isBanned() && isAdmin()
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(['isApproved', 'isHidden', 'decidedAt', 'deletedAt', 'deletedBy', 'comments', 'commentAuthorIds', 'reactions', 'poll', 'likes', 'reposts', 'viewCount', 'adClicks', 'isAd']);
      // Hard delete is for the superadmin; authors soft-delete (restorable for 30
      // days) or erase permanently through the server.
      allow delete: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // Direct Messages (forum_conversations & messages subcollection)
    // ──────────────────────────────────────────────
    // The conversation id is `<uidA>_<uidB>` (see DirectMessagesModal), so it is
    // guessable from two public uids. Access therefore never rests on knowing the
    // id: every read and write is checked against the `participants` list.
    function isConversationMember(convId) {
      return isAuthenticated() && request.auth.uid in
        get(/databases/$(database)/documents/forum_conversations/$(convId)).data.participants;
    }

    match /forum_conversations/{convId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;

      // Conversations and messages are written ONLY by the server
      // (server/directMessages.ts): it enforces blocks, privacy and message
      // requests and owns the unread counters and the recipient's notification.
      // The browser reads (live) and calls the API; it can no longer create a
      // thread, flip a request to "active", or set anyone's counter.
      allow create, update: if false;

      match /messages/{messageId} {
        allow read: if isConversationMember(convId);
        allow create: if false;
        allow update, delete: if isSuperAdmin()
                      || (isConversationMember(convId) && resource.data.senderId == request.auth.uid);
      }
    }

    // Blocks and DM privacy: readable by their owner, written only by the server
    // (which also ends the follow relationship when it records a block). The
    // blocked person can never read the list, so a block is not detectable.
    match /forum_blocks/{blockDocId} {
      allow read: if isAuthenticated() && resource.data.blockerId == request.auth.uid;
      allow write: if false;
    }

    match /forum_dm_settings/{settingsUid} {
      allow read: if isAuthenticated() && settingsUid == request.auth.uid;
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // Official Profiles — public read, admin write
    // ──────────────────────────────────────────────
    match /officialProfiles/{profileId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Verified public work contacts used by the admin report-routing tool.
    // The directory is not public because the admin controls its contents.
    match /reportRoutingContacts/{contactId} {
      allow read, create, update, delete: if isAdmin() || isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // System Settings — public read, superadmin write
    // ──────────────────────────────────────────────
    // The settings document is world-readable because the public site reads
    // `showReels` and the ad contact details on every page load. That same
    // document also carried the AdSense publisher id, slot and ad code, so a
    // blanket `read: if true` published credentials that are enough to serve
    // or spoof the platform's ads. The credentials moved to `ads-private`
    // below; only the fields the public site genuinely needs stay here.
    match /settings/general {
      allow read: if true;
      // An admin may edit the public settings but not the AdSense fields, which
      // belong to the owner (superadmin) alone.
      allow create: if isSuperAdmin() &&
                    (isOwner() || !request.resource.data.keys().hasAny([
                      'adSenseEnabled', 'adSenseClientId', 'adSenseSlot', 'adSenseCode'
                    ]));
      allow update: if isSuperAdmin() &&
                    (isOwner() || !request.resource.data.diff(resource.data)
                      .affectedKeys().hasAny([
                        'adSenseEnabled', 'adSenseClientId', 'adSenseSlot', 'adSenseCode'
                      ]));
      allow delete: if isSuperAdmin();
    }

    // AdSense credentials — owner (superadmin) only, for reads and writes.
    // These are secrets, not public-interest data: an exposed client id and
    // slot let anyone point ad traffic at the platform's account, and the ad
    // code field is injected into the page.
    match /settings/ads-private {
      allow read, create, update, delete: if isOwner();
    }

    // Any other settings document keeps the original public-read contract,
    // except for writes, which remain admin-only.
    //
    // Firestore ORs every `match` that covers a document, so a wildcard sibling
    // silently re-grants whatever the specific blocks above restrict. The
    // wildcard therefore has to exclude the two documents that have their own
    // rules; before this, `settings/ads-private` was readable by the whole
    // internet and the AdSense guard on `settings/general` could be bypassed.
    match /settings/{settingId} {
      allow read: if settingId != 'general' && settingId != 'ads-private';
      allow create, update, delete: if settingId != 'general' && settingId != 'ads-private' && isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // Budget Allocations — authenticated create, admin write
    // ──────────────────────────────────────────────
    // Public read was removed: these documents carry per-district financial
    // figures that are not public-interest disclosures, so they are read
    // through the server (which is authenticated) or by staff.
    match /budgetAllocations/{allocationId} {
      allow read: if isAuthenticated();
      allow create: if canAct();
      allow update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // Chats — ONLY participants can read/write
    // ──────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, update: if isChatParticipant() || isAdmin();
      allow create: if canAct() &&
                    request.resource.data.userId == request.auth.uid;
      allow delete: if isChatParticipant() || isAdmin();

      match /messages/{messageId} {
        allow read, create: if isChatParticipant() || isAdmin();
        allow update, delete: if isChatParticipant() || isAdmin();
      }
    }

    function isChatParticipant() {
      return isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        resource.data.participants.hasAny([request.auth.uid])
      );
    }

    // ──────────────────────────────────────────────
    // Live Messages — public create/read, admin moderate
    // ──────────────────────────────────────────────
    // Unbounded public reads here are a direct billing hazard: one page that
    // subscribes to the whole collection is one read per document per listener.
    match /liveMessages/{messageId} {
      allow read: if true;
      allow create: if canAct() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.text is string &&
                    request.resource.data.text.size() <= 1000 &&
                    request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // Health Registry — SENSITIVE PII, admin/owner ONLY
    // ──────────────────────────────────────────────
    match /healthRegistry/{recordId} {
      // NO public read. Only the owner or staff can read.
      allow read: if isAuthenticated() && (
        resource.data.authorId == request.auth.uid ||
        isHealthStaff()
      );
      // Authenticated owners retain private records; unauthenticated submissions
      // are accepted only as bounded, unverified requests with explicit consent.
      allow create: if (
        isAuthenticated() && !isGuest() &&
        request.resource.data.authorId == request.auth.uid &&
        request.resource.data.fullName is string &&
        request.resource.data.healthCondition is string &&
        request.resource.data.contactVisibility == 'admin_only'
      ) || (
        (!isAuthenticated() || isGuest()) &&
        request.resource.data.keys().hasOnly([
          'trackingId', 'expiresAt', 'fullName', 'age', 'gender', 'municipality',
          'neighborhood', 'category', 'diagnosis', 'healthCondition',
          'diagnosedYear', 'urgency', 'needs', 'description', 'contactPhone',
          'contactName', 'isAnonymous', 'contactVisibility',
          'hospitalPrivacyNotice', 'supportAmountNeeded', 'supportAmountRaised',
          'hospitalNotified', 'status', 'createdAt', 'consentToProcessing',
          'authorId'
        ]) &&
        request.resource.data.fullName is string &&
        request.resource.data.fullName.size() <= 120 &&
        request.resource.data.age is int &&
        request.resource.data.age >= 0 &&
        request.resource.data.age <= 120 &&
        request.resource.data.gender in ['Mashkull', 'Femër', 'Tjetër'] &&
        request.resource.data.municipality is string &&
        request.resource.data.municipality.size() <= 80 &&
        request.resource.data.neighborhood is string &&
        request.resource.data.neighborhood.size() <= 120 &&
        request.resource.data.category is string &&
        request.resource.data.category.size() <= 80 &&
        request.resource.data.diagnosis is string &&
        request.resource.data.diagnosis.size() > 0 &&
        request.resource.data.diagnosis.size() <= 300 &&
        request.resource.data.healthCondition == request.resource.data.diagnosis &&
        request.resource.data.diagnosedYear is int &&
        request.resource.data.diagnosedYear >= 1900 &&
        request.resource.data.diagnosedYear <= 2100 &&
        request.resource.data.urgency in ['Urgjente', 'Mesatare', 'Kronike e Stabilizuar'] &&
        request.resource.data.needs is list &&
        request.resource.data.needs.size() <= 10 &&
        (request.resource.data.needs.size() < 1 ||
          (request.resource.data.needs[0] is string && request.resource.data.needs[0].size() <= 120)) &&
        (request.resource.data.needs.size() < 2 ||
          (request.resource.data.needs[1] is string && request.resource.data.needs[1].size() <= 120)) &&
        (request.resource.data.needs.size() < 3 ||
          (request.resource.data.needs[2] is string && request.resource.data.needs[2].size() <= 120)) &&
        (request.resource.data.needs.size() < 4 ||
          (request.resource.data.needs[3] is string && request.resource.data.needs[3].size() <= 120)) &&
        (request.resource.data.needs.size() < 5 ||
          (request.resource.data.needs[4] is string && request.resource.data.needs[4].size() <= 120)) &&
        (request.resource.data.needs.size() < 6 ||
          (request.resource.data.needs[5] is string && request.resource.data.needs[5].size() <= 120)) &&
        (request.resource.data.needs.size() < 7 ||
          (request.resource.data.needs[6] is string && request.resource.data.needs[6].size() <= 120)) &&
        (request.resource.data.needs.size() < 8 ||
          (request.resource.data.needs[7] is string && request.resource.data.needs[7].size() <= 120)) &&
        (request.resource.data.needs.size() < 9 ||
          (request.resource.data.needs[8] is string && request.resource.data.needs[8].size() <= 120)) &&
        (request.resource.data.needs.size() < 10 ||
          (request.resource.data.needs[9] is string && request.resource.data.needs[9].size() <= 120)) &&
        request.resource.data.description is string &&
        request.resource.data.description.size() <= 2000 &&
        request.resource.data.contactPhone is string &&
        request.resource.data.contactPhone.size() <= 40 &&
        request.resource.data.contactName is string &&
        request.resource.data.contactName.size() <= 120 &&
        request.resource.data.trackingId is string &&
        request.resource.data.trackingId.size() <= 40 &&
        request.resource.data.expiresAt is string &&
        request.resource.data.hospitalPrivacyNotice is string &&
        request.resource.data.hospitalPrivacyNotice.size() <= 500 &&
        request.resource.data.isAnonymous is bool &&
        request.resource.data.contactVisibility == 'admin_only' &&
        request.resource.data.supportAmountNeeded is number &&
        request.resource.data.supportAmountNeeded >= 0 &&
        request.resource.data.supportAmountNeeded <= 1000000 &&
        request.resource.data.supportAmountRaised == 0 &&
        request.resource.data.hospitalNotified == false &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is string &&
        request.resource.data.consentToProcessing == true &&
        (
          (request.resource.data.isAnonymous == true &&
            request.resource.data.fullName == '' &&
            request.resource.data.contactPhone == '' &&
            request.resource.data.contactName == '') ||
          (request.resource.data.isAnonymous == false &&
            request.resource.data.fullName.size() > 0)
        ) &&
        (
          request.auth == null ||
          request.resource.data.authorId == request.auth.uid
        )
      );
      allow update: if isHealthStaff() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // ──────────────────────────────────────────────
    // Medicine shortages — moderated, public once verified
    // ──────────────────────────────────────────────
    // Citizens and institutions report which medicines are missing where. A
    // report is `pending` until staff/municipality verify it; only VERIFIED
    // shortages are world-readable, so an unverified claim (which can name a
    // pharmacy) never reaches the public feed. The owner can always see their
    // own report; staff see the whole queue. Carries no medical PII about the
    // reporter beyond their uid, and the UI honours `isAnonymous`.
    match /medicineShortages/{shortageId} {
      allow read: if resource.data.status == 'verified' ||
                  isStaff() ||
                  (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow create: if canAct() && !isGuest() &&
                    request.resource.data.authorId == request.auth.uid &&
                    request.resource.data.medicineName is string &&
                    request.resource.data.municipality is string &&
                    request.resource.data.reportedDate is string &&
                    request.resource.data.isAnonymous is bool &&
                    request.resource.data.status == 'pending';
      allow update: if isStaff() ||
                    (isAuthenticated() && resource.data.authorId == request.auth.uid);
      allow delete: if isAdmin() || isSuperAdmin() ||
                    (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }

    // ──────────────────────────────────────────────
    // Ad Requests — authenticated create, admin read
    // ──────────────────────────────────────────────
    match /adRequests/{requestId} {
      // Only authenticated users can read their own requests
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
      allow create: if canAct() &&
                    request.resource.data.userId == request.auth.uid &&
                    request.resource.data.phone is string &&
                    request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // ──────────────────────────────────────────────
    // Banned IPs — admin only
    // ──────────────────────────────────────────────
    match /bannedIPs/{ipId} {
      allow read, write: if isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // Audit Logs — append-only
    // ──────────────────────────────────────────────
    // Update and delete are denied to everyone, including superadmin. An audit
    // log that the most privileged account can rewrite answers none of the
    // questions an audit log exists to answer, and this is the one collection
    // where that matters most. The previous rule let a superadmin delete
    // entries, which would have made the log useless as evidence.
    match /auditLogs/{logId} {
      allow read: if isStaff() || isMonitor();
      // Written only by the server (POST /api/v1/audit and audit() in server/auth.ts),
      // which stamps the actor from the verified token. A client path let any staff
      // account file entries under somebody else's name.
      allow create, update, delete: if false;
    }

    // ──────────────────────────────────────────────
    // Editorial Log — append-only, staff-readable
    // ──────────────────────────────────────────────
    // Every editorial action attempted by a municipal account, including the
    // ones the firewall refused. Append-only for the same reason as auditLogs,
    // and more pointedly: a municipality is the subject of roughly half these
    // entries, so an editable log would let the party under scrutiny edit the
    // evidence.
    //
    // Read is staff-only and deliberately not available to a municipality even
    // for entries about itself. A municipality cannot request a copy of the
    // record of its own denied attempts; the annual transparency report
    // summarises it instead, which is the accountability that was promised.
    match /editorialLog/{entryId} {
      allow read: if isStaff();
      // Written only by the server (Admin SDK), which bypasses rules. A client
      // path would let any signed-in user forge entries - including `denied`
      // ones for another municipality, which feed the public transparency
      // report - so it is closed outright.
      allow create: if false;
      allow update, delete: if false;
    }

    // ──────────────────────────────────────────────
    // Work Facts — municipality-authored, staff-verified
    // ──────────────────────────────────────────────
    // What a municipality says it fixed. The load-bearing rule is the update
    // line: a municipality is not in isStaff(), so it cannot change `review` at
    // all. Without that, a municipality could file an entry and immediately mark
    // it `confirmed`, which is the same power as editing the citizen's report,
    // just slower.
    match /workFacts/{factId} {
      // Public read for confirmed entries only. An unverified claim is the
      // municipality's assertion, not a fact, and publishing it as one would
      // misrepresent the record. Staff see everything in order to review it.
      allow read: if resource.data.review == 'confirmed' || isStaff();

      // A municipality may file only against its own name, only with the review
      // state the server expects, and only inside its own jurisdiction — the
      // municipality field must match its token claim, so it cannot file on
      // behalf of a neighbouring authority.
      allow create: if isAuthenticated() && !isBanned() && (
        (isMunicipality() &&
          request.resource.data.municipality == ownMunicipality() &&
          request.resource.data.authorUserId == request.auth.uid &&
          request.resource.data.review == 'pending' &&
          request.resource.data.description is string &&
          request.resource.data.description.size() >= 20 &&
          request.resource.data.description.size() <= 800 &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.keys().hasOnly([
            'reportId', 'description', 'completedAt', 'performedBy', 'cost',
            'attachments', 'municipality', 'authorUserId', 'authorEmail',
            'review', 'createdAt'
          ]))
        || isAdmin()
      );

      // Only staff may move an entry between review states. The claim text,
      // author and timestamp are never editable — by anyone — so the record of
      // who said what and when survives even if the claim is later disproved.
      allow update: if isStaff() &&
                      request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['review', 'reviewedBy', 'reviewedAt']);

      // A municipality may retract its own unverified entry; once confirmed it
      // is part of the public record and only a superadmin can remove it.
      allow delete: if (isMunicipality() &&
                        resource.data.authorUserId == request.auth.uid &&
                        resource.data.review == 'pending')
                    || isSuperAdmin();
    }

    // ──────────────────────────────────────────────
    // Work items (shared workflow engine): server-written, role-scoped reads
    //
    // No client ever creates, edits or deletes any of these; the Admin SDK in
    // server/workItems.ts is the only writer (it bypasses rules), so the
    // transition validator cannot be skipped from a browser. Reads are the
    // narrowest that still lets each console list its own work:
    //   - supervisors (admin, superadmin, dispatcher, read-only monitor): all
    //   - an agent: items assigned to them
    //   - a municipality: report referrals addressed to its own municipality
    // The event history holds internal notes, so a municipality never reads it.
    // ──────────────────────────────────────────────
    function isWorkManager() {
      return isSuperAdmin() || (isAuthenticated() && request.auth.token.role == 'dispatcher');
    }

    function isWorkSupervisor() {
      return isWorkManager() || isMonitor();
    }

    match /workItems/{itemId} {
      allow read: if isWorkSupervisor()
                  || (isAuthenticated() && request.auth.token.agent == true && resource.data.assigneeUid == request.auth.uid)
                  || (isMunicipality() && resource.data.kind == 'report_referral'
                      && resource.data.municipality == ownMunicipality())
                  || (isAuthenticated() && resource.data.kind == 'moderation_case'
                      && (request.auth.token.role == 'moderator' || request.auth.token.debatwp == true));
      allow write: if false;

      match /events/{eventId} {
        allow read: if isWorkSupervisor()
                    || (isAuthenticated() && request.auth.token.agent == true
                        && get(/databases/$(database)/documents/workItems/$(itemId)).data.assigneeUid == request.auth.uid);
        allow write: if false;
      }
    }

    match /workerProfiles/{uid} {
      allow read: if isWorkSupervisor() || (isAuthenticated() && request.auth.uid == uid);
      allow write: if false;
    }

    match /workNotifications/{noteId} {
      allow read: if isAuthenticated() && (
        resource.data.toUid == request.auth.uid
        || (resource.data.toRole == 'manager' && isWorkManager()));
      // The recipient may mark a notification read, and nothing else about it.
      allow update: if isAuthenticated() && resource.data.toUid == request.auth.uid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAtMs']);
      allow create, delete: if false;
    }

    match /workflowConfig/{configId} {
      allow read: if isWorkSupervisor();
      allow write: if false;
    }

    // ──────────────────────────────────────────────
    // Deny all other access by default
    // ──────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
