# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Client Configuration (auto-populated or manually entered)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# Firebase App Check. REQUIRED if "Enforce" is on for Authentication in
# Firebase Console → App Check → APIs: without a token every sign-in call
# (Google, email, anonymous guest) fails with 401 "App Check token is invalid".
# Register the web app with reCAPTCHA there and paste the site key. Provider is
# "v3" (default) or "enterprise". On localhost the dev build prints a debug
# token to the console; register it under App Check → Manage debug tokens.
VITE_FIREBASE_APPCHECK_SITE_KEY=""
VITE_FIREBASE_APPCHECK_PROVIDER="v3"
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=""

# Google Analytics 4 (Format: G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Local admin testing is enabled only by `npm run dev:admin-prototype`.
# That command starts Auth/Firestore/Storage emulators with demo-* project IDs;
# never enable these variables for production or against a real Firebase project.
VITE_PROTOTYPE_ADMIN="false"
VITE_PROTOTYPE_FIREBASE_EMULATORS="false"


# --- Email to institutions (optional) ---------------------------------------
# Sends a report to the responsible institution from the platform and records it.
# Leave empty to keep messages "queued" until a provider is set.
# MAIL_PROVIDER=sendgrid        # sendgrid | mailgun | resend
# MAIL_API_KEY=
# MAIL_FROM="Zëri i Qytetarëve <no-reply@your-domain>"   # a sender verified with the provider
# MAIL_REPLY_TO=
# MAILGUN_DOMAIN=               # Mailgun only
# MAILGUN_REGION=eu             # Mailgun only: eu | us
# PUBLIC_APP_URL=https://your-domain   # used for the link back to the report in the email
