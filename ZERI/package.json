    "@types/hpp": "^0.2.7",
    "@types/leaflet": "^1.9.21",
    "@types/leaflet.heat": "^0.2.5",
    "@types/node": "^22.14.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^3.2.7",
