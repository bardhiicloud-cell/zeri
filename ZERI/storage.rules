rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ──────────────────────────────────────────────
    // Report media (images/videos/documents/audio uploaded by citizens)
    // ──────────────────────────────────────────────
    match /reports/{userId}/{reportId}/{imageId} {
      // Read: anyone with the URL can view (public content)
      allow read: if true;

      // Write: authenticated user uploading their own report media.
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024  // 15 MB max
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType.matches('video/.*') ||
                     request.resource.contentType.matches('application/pdf') ||
                     request.resource.contentType.matches('application/msword') ||
                     request.resource.contentType.matches('application/vnd.openxmlformats-officedocument.wordprocessingml.document') ||
                     request.resource.contentType.matches('text/plain') ||
                     request.resource.contentType.matches('audio/.*')
                   );
    }

    // ──────────────────────────────────────────────
    // Forum & Social Media Uploads (Posts, DMs, Stories, Reels)
    // ──────────────────────────────────────────────
    match /forum_dms/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }

    match /forum_reels/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 30 * 1024 * 1024;
    }

    match /forumStories/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 30 * 1024 * 1024;
    }

    match /forum/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 15 * 1024 * 1024;
    }

    // ──────────────────────────────────────────────
    // User avatars — owner-only
    // ──────────────────────────────────────────────
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024  // 5 MB max
                   && request.resource.contentType.matches('image/.*');
    }

    // ──────────────────────────────────────────────
    // Health registry images — staff or owner only
    // ──────────────────────────────────────────────
    match /health/{uid}/{recordId}/{imageId} {
      allow read: if request.auth != null
              && (request.auth.uid == uid ||
                request.auth.token.admin == true ||
                request.auth.token.role in ['admin', 'superadmin', 'approver']);
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 10 * 1024 * 1024  // 10 MB max
                   && (
                     request.resource.contentType.matches('image/.*') ||
                     request.resource.contentType.matches('application/pdf')
                   );
    }

    // Deny all other storage access
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
